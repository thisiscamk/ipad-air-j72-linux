From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: J72 bring-up <j72@localhost>
Date: Mon, 2 Nov 2026 07:56:56 +0800
Subject: [PATCH] J72 observer: keep USB recovery when ANS firmware handoff is
 unavailable

---
 src/kboot.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/src/kboot.c b/src/kboot.c
index ebd6282..8df1824 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -2596,11 +2596,18 @@ static int dt_set_asp_fwdata(void)
     }
 
     int fw_node = adt_first_child_offset(adt, adt_node);
-    if (!fw_node)
-        bail("ADT: IOP Firmware node not found\n");
-
-    if (!akf_fw_get_region(fw_node, &phys, &iova, &size))
-        return -1;
+    if (fw_node <= 0 || !akf_fw_get_region(fw_node, &phys, &iova, &size) ||
+        !phys || !size || size > (64ULL << 20) || ((phys | size) & 0xfff) ||
+        phys >= (1ULL << 40) || size > (1ULL << 40) - phys) {
+        /* This image carries USB recovery and no automatic ASP probe.
+         * A missing handoff must not prevent reading diagnostics in Linux.
+         * Leave the placeholder unfilled and disable the storage device.
+         */
+        printf("J72 observer: ANS firmware handoff unavailable; keeping USB recovery\n");
+        if (fdt_setprop_string(dt, fdt_node, "status", "disabled") < 0)
+            return -1;
+        return 0;
+    }
 
     int mem_node = dt_get_or_add_reserved_mem("ans-firmware", "apple,iop-mem", true, phys, size);
     if (mem_node < 0)
-- 
2.47.3

