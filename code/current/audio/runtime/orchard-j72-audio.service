[Unit]
Description=Experimental iPad Air J72 speaker hardware
After=local-fs.target systemd-udevd.service
Before=user@1000.service
ConditionPathExists=/proc/device-tree/compatible

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/orchard/j72-audio/start-audio.py
ExecStop=/usr/bin/python3 /usr/local/lib/orchard/j72-audio/start-audio.py --mute
RemainAfterExit=yes
TimeoutStartSec=90
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
