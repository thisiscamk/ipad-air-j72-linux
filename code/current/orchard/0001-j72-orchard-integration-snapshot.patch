@@ -0,0 +1,55 @@
+"""The model-selected J72 native firmware recipe and input extraction."""
+import json
+from pathlib import Path
+import struct
+import unittest
+from unittest.mock import Mock
+import zlib
+
+from orchard import recipe
+from orchard.apple import apfs
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class J72FirmwareRecipe(unittest.TestCase):
+    def test_native_recipe_names_only_pinned_j72_touch_input(self):
+        description = recipe.check(json.loads((ROOT / 'devices/j72/firmware.json').read_text()))
+        self.assertEqual(recipe.needed_inputs(description), ['J72.mtprops'])
+        self.assertEqual(len(description['outputs']), 1)
+        output = description['outputs'][0]
+        self.assertEqual(output['destination'], 'lib/firmware/apple/j72-fwstart.z2fw')
+        self.assertEqual(output['sha256'],
+                         '73ca290607695ca841867a2bf76cab4bc2f5c33b9ab5ac171de5b5580a7c0c09')
+        step = output['steps'][0]
+        self.assertEqual(step['step'], 'z2fw-from-z2-packet@2')
+        self.assertEqual(step['profile'], 'C1F15,1')
+        self.assertEqual(step['calibration_size'], 1024)
+        self.assertEqual(step['prox_size'], 128)
+        with self.assertRaisesRegex(ValueError, 'Firmware input differs'):
+            recipe.run(description, lambda name: b'wrong model or input')
+
+    def test_unrequested_outputs_do_not_read_firmware_inputs(self):
+        description = recipe.check(json.loads((ROOT / 'devices/j72/firmware.json').read_text()))
+        self.assertEqual(recipe.needed_inputs(description, outputs=[]), [])
+        self.assertEqual(recipe.run(description,
+                                    Mock(side_effect=AssertionError('unexpected input')), outputs=[]), {})
+
+    def test_existing_type4_resource_decoder_handles_compressed_and_stored_blocks(self):
+        # Entirely synthetic, with the same two-block storage form as the input.
+        first, second = b'a' * 65536, b'synthetic logical file tail'
+        pieces = [zlib.compress(first), b'\xff' + second]
+        base = 0x104
+        table = bytearray(struct.pack('<I', len(pieces)))
+        offset = 4 + 8 * len(pieces)
+        for piece in pieces:
+            table.extend(struct.pack('<II', offset, len(piece)))
+            offset += len(piece)
+        fork = struct.pack('>I', 0x100).ljust(base, b'\0') + table + b''.join(pieces)
+        self.assertEqual(apfs._resource_fork(4, fork, len(first + second)), first + second)
+        with self.assertRaisesRegex(ValueError, 'size mismatch'):
+            apfs._resource_fork(4, fork, len(first + second) + 1)
+
+
+if __name__ == '__main__':
+    unittest.main()
