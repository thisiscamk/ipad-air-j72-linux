+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 18:58:51 +0800
+Subject: [PATCH] spi: apple: Add the S5L8960X explicit PIO transfer path
+
+Select the S5L8960X register and transfer policy through match data.
+Measured J72 transfers require RUN before explicit TXDATA, AUTO_TX only
+for receive-only clocking, normal bit-13 LSB-first semantics, and RX
+draining during transmit-only payloads. Bound all unreceived explicit
+words to the 16-word FIFO and fail stalled or invalid FIFO states with
+the controller stopped.
+
+Retain byte-wide transfers, inter-word delay and an expected-wire-time
+plus 200ms timeout; use wide multiplication for large transfer
+deadlines. Existing T7000, S8000, T8010 and M-series transfer
+implementations and match data remain unchanged.
+
+The measured reference is thisiscamk/ipad-air-j72-linux code/spi/spi-
+apple.c, SHA256:
+
+5537f16910e83406c9a40f52495262739f41a36070b3959437069910c1548fe8
+
+Preserve the Asahi/SiFive notices. Earlier S5L work is from Martin
+Puskac via mattonik/ipad-nixos b94d42f78e04c5465e290340a5b6879bbc5956b6.
+This ports the measured policy to the current driver; it does not claim
+that this native revision has booted.
+
+The bounded PIO servicing structure follows the existing S8000 path by
+Berkay Kosebay (Orchard drivers/spi patch 0006); its register ordering
+and transfer function remain unchanged.
+
+Host compilation of the actual new transfer body passes bounded MMIO
+fixtures with undefined/bounds sanitizers. Full kernel/schema builds,
+resource ownership and physical-controller regressions remain pending.
+
+Assisted-by: LLM
+---
+ drivers/spi/spi-apple.c | 155 ++++++++++++++++++++++++++++++++++++++--
+ 1 file changed, 151 insertions(+), 4 deletions(-)
+
+diff --git a/drivers/spi/spi-apple.c b/drivers/spi/spi-apple.c
+index dc5154e1b..129799a27 100644
+--- a/drivers/spi/spi-apple.c
++++ b/drivers/spi/spi-apple.c
+@@ -15,6 +15,9 @@
+ #include <linux/gpio/consumer.h>
+ #include <linux/interrupt.h>
+ #include <linux/io.h>
++#include <linux/ktime.h>
++#include <linux/limits.h>
++#include <linux/math64.h>
+ #include <linux/module.h>
+ #include <linux/of.h>
+ #include <linux/of_device.h>
+@@ -46,6 +49,8 @@
+ #define APPLE_SPI_CFG_T8010_BASE	0x0010401e
+ #define APPLE_SPI_CFG_T7000_BASE	0x00004018
+ #define APPLE_SPI_CFG_S8000_BASE	0x00004018
++#define APPLE_SPI_CFG_S5L8960X_BASE	0x00044038
++#define APPLE_SPI_CFG_S5L8960X_AUTO_TX	BIT(0)
+ #define APPLE_SPI_CFG_T8010_PIOEN	BIT(5)
+ #define APPLE_SPI_CFG_T8010_16BIT	BIT(15)
+ 
+@@ -124,10 +129,11 @@ struct apple_spi_hw {
+ 	/* T7000: the SPI version 1 configuration register layout. */
+ 	bool spi_v1;
+ 	/*
+-	 * S8000: the T8010 register layout, driven by byte-wide PIO only,
+-	 * without the descriptor format, DMA or the interrupt registers.
++	 * Byte-wide polled PIO, without descriptor DMA or interrupt registers.
+ 	 */
+ 	bool pio_only;
++	/* S5L8960X: start before TXDATA; AUTO_TX is receive-only. */
++	bool s5l8960x;
+ 	unsigned int min_clk_div;
+ 	u32 default_word_delay;
+ 	u32 cfg_base;
+@@ -196,6 +202,17 @@ static void apple_spi_t8010_clear_status(struct apple_spi *spi)
+ 
+ static void apple_spi_init(struct apple_spi *spi)
+ {
++	if (spi->hw->s5l8960x) {
++		reg_write(spi, APPLE_SPI_PIN, APPLE_SPI_PIN_CS);
++		reg_write(spi, APPLE_SPI_CTRL,
++			  APPLE_SPI_CTRL_RX_RESET | APPLE_SPI_CTRL_TX_RESET);
++		reg_write(spi, APPLE_SPI_CFG, spi->hw->cfg_base);
++		reg_write(spi, APPLE_SPI_STATUS,
++			  reg_read(spi, APPLE_SPI_STATUS));
++		reg_write(spi, APPLE_SPI_WORD_DELAY, 0);
++		return;
++	}
++
+ 	if (spi->hw->legacy_status) {
