+"""Select the actual J72 ASP namespace without changing other boards or overrides."""
+from pathlib import Path
+import os
+import unittest
+from unittest.mock import patch
+from orchard import install_device as D
+
+class InstallDisk(unittest.TestCase):
+    def test_j72_inspection_waits_for_storage_then_uses_asp(self):
+        calls=[]
+        with patch.dict(os.environ, {}, clear=True), patch.object(Path,'read_bytes',return_value=b'apple,j72\0apple,s5l8960x\0'), patch.object(D,'wait_for_storage',side_effect=lambda:calls.append('ready')), patch.object(D,'inspect',side_effect=lambda disk:calls.append(disk)):
+            self.assertEqual(D.main(['install_device.py','inspect']),0)
+        self.assertEqual(calls,['ready','/dev/asp0n1'])
+
+    def test_existing_operator_override_is_preserved_without_device_tree_read(self):
+        with patch.dict(os.environ,{'ORCHARD_INSTALL_DISK':'/dev/explicit-operator-target'},clear=True), patch.object(Path,'read_bytes',side_effect=AssertionError('Override must not read hardware identity')):
+            self.assertEqual(D.inspection_disk(),'/dev/explicit-operator-target')
+
+    def test_other_boards_and_absent_device_tree_keep_nvme_default(self):
+        with patch.dict(os.environ,{},clear=True):
+            for data in (b'apple,j71b\0',b'apple,n61\0',b'apple,j72b\0',b''):
+                with self.subTest(data=data),patch.object(Path,'read_bytes',return_value=data):
+                    self.assertEqual(D.inspection_disk(),D.DEFAULT_DISK)
+            with patch.object(Path,'read_bytes',side_effect=FileNotFoundError):
+                self.assertEqual(D.inspection_disk(),D.DEFAULT_DISK)
+
+if __name__=='__main__':unittest.main()
