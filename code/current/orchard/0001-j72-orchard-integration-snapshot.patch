new file mode 100755
index 0000000..318546d
--- /dev/null
+++ b/runtime/recovery/storage-j72.py
@@ -0,0 +1,133 @@
+#!/usr/bin/python3
+"""Initialize and fence the J72's real ASP namespace once per recovery boot.
+
+No format, reset, unload or controller retry. The unqualified read-only
+prototype cannot satisfy this fence; installation stays blocked until a
+qualified driver exposes the normal writable disk and its partitions.
+"""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+COMPATIBLE = Path('/proc/device-tree/compatible')
+SYS_BLOCK = Path('/sys/class/block')
+DEV = Path('/dev')
+RUN = Path('/run/orchard')
+MOUNTINFO = Path('/proc/self/mountinfo')
+MODULE_SECONDS = 90
+DEVICE_SECONDS = 30
+DISK = 'asp0n1'
+
+
+def command(*argv):
+    result = subprocess.run(argv, capture_output=True, timeout=15)
+    if result.returncode:
+        raise RuntimeError(f'{argv[0]} failed (exit {result.returncode})')
+
+
+def wait_for(predicate, seconds, detail):
+    deadline = time.monotonic() + seconds
+    while not predicate():
+        if time.monotonic() >= deadline:
+            raise RuntimeError(detail)
+        time.sleep(0.2)
+
+
+def require_unused_storage():
+    blocks = list(SYS_BLOCK.glob('asp*n*'))
+    numbers = {(block / 'dev').read_text().strip() for block in blocks}
+    for line in MOUNTINFO.read_text().splitlines():
+        fields = line.split()
+        separator = fields.index('-')
+        source = fields[separator + 2]
+        if fields[2] in numbers or source.startswith('/dev/asp'):
+            raise RuntimeError('ASP storage is already mounted; no initialization')
+    for block in blocks:
+        if any((block / 'holders').iterdir()):
+            raise RuntimeError('ASP storage has an active block holder: ' + block.name)
+
+
+def initialize(record, save):
+    if b'apple,j72' not in COMPATIBLE.read_bytes().split(b'\0'):
+        raise RuntimeError('The ASP storage fence requires the J72 device tree')
+    require_unused_storage()
+    record['step'] = 'load'
+    with (RUN / 'j72-asp-load.log').open('x') as log:
+        process = subprocess.Popen(['modprobe', 'asp'], stdin=subprocess.DEVNULL,
+                                   stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+        record.update(module_load_attempted=True, module_pid=process.pid)
+        save()
+        deadline = time.monotonic() + MODULE_SECONDS
+        while process.poll() is None:
+            if time.monotonic() >= deadline:
+                record['module_terminal'] = False
+                save()
+                raise RuntimeError(f'ASP module load is still pending at PID {process.pid}; inspect that same process, no retry')
+            time.sleep(0.2)
+        record.update(module_terminal=True, module_exit=process.returncode)
+        save()
+        if process.returncode:
+            raise RuntimeError(f'ASP module load refused (exit {process.returncode}); no retry')
+    record['step'] = 'namespace'
+    save()
+    disk = SYS_BLOCK / DISK
+    wait_for(lambda: disk.is_dir() and (DEV / DISK).is_block_device(), DEVICE_SECONDS,
+             'The real ASP user namespace did not appear')
+    if (disk / 'queue/logical_block_size').read_text().strip() != '4096':
+        raise RuntimeError('Unexpected J72 ASP logical block size')
+    if (disk / 'ro').read_text().strip() != '0':
+        raise RuntimeError('ASP is read-only; writable driver qualification is required')
+    record['step'] = 'partitions'
+    save()
+    wait_for(lambda: bool(list(SYS_BLOCK.glob(DISK + 'p*/partition'))), DEVICE_SECONDS,
+             'ASP partition discovery is unavailable; no storage readiness')
+    require_unused_storage()
+    for block in sorted(SYS_BLOCK.glob(DISK + 'p*')):
+        if not (block / 'partition').is_file():
+            continue
+        command('blockdev', '--setro', str(DEV / block.name))
+        if (block / 'ro').read_text().strip() != '1':
+            raise RuntimeError('Could not fence ASP partition ' + block.name)
+    record['step'] = 'namespaces'
+    save()
+    for block in sorted(SYS_BLOCK.glob('asp*n*')):
+        if (block / 'partition').exists() or block.name == DISK:
+            continue
+        command('blockdev', '--setro', str(DEV / block.name))
+        if (block / 'ro').read_text().strip() != '1':
+            raise RuntimeError('Could not fence auxiliary ASP namespace ' + block.name)
+    record.update(status='READY', step='done', disk=str(DEV / DISK), partitions_read_only=True)
+    save()
+    (RUN / 'storage-ready').write_text('ready\n')
+
+
+def main():
+    RUN.mkdir(parents=True, exist_ok=True)
+    try:
+        # A consumed attempt is an admission record, not a claim that its
+        # process is still live. Preserve its PID/status for inspection.
+        with (RUN / 'j72-asp-fence-entered').open('x') as once:
+            once.write('ENTERED\n')
+    except FileExistsError:
+        print('J72 ASP initialization was already attempted; inspect its existing record', file=sys.stderr)
+        return 1
+    for name in ('storage-ready', 'storage-failed'):
+        (RUN / name).unlink(missing_ok=True)
+    record = {'status': 'RUNNING', 'step': 'identity', 'module_load_attempted': False}
+    def save():
+        (RUN / 'j72-asp-storage.json').write_text(json.dumps(record, indent=2) + '\n')
+    save()
+    try:
+        initialize(record, save)
+    except Exception as error:
+        record.update(status='READINESS_REFUSED', error=str(error))
+        save()
+        (RUN / 'storage-failed').write_text(record['step'] + ': ' + str(error) + '\n')
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
