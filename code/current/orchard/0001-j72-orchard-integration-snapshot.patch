+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:56:53 +0800
+Subject: [PATCH] arm64: dts: apple: connect the J72 N1 touchscreen resources
+
+Describe SPI2 native chip select, reset and attention pins, the independent touch reference clock, D2089 analog/core supplies and display-sync states. Enable the prerequisite providers and keep the touchscreen consumer as a separately loaded module for qualification.
+
+Add touchscreen0 for normal m1n1 per-unit calibration handoff and use the private-firmware converter output name. No calibration or Apple firmware bytes are embedded in the static DT.
+
+ARM64 W=1 objects and J72 DTB compile; current binding meta-validation and compiled J72/existing example schema checks pass. Native power/touch and shutdown remain unqualified until hardware testing.
+
+Assisted-by: LLM
+---
+ arch/arm64/boot/dts/apple/s5l8960x-j72.dts | 44 ++++++++++++++++++++++
+ 1 file changed, 44 insertions(+)
+
+diff --git a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
+index cdf306a4a..a80e2acac 100644
+--- a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
++++ b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
+@@ -61,3 +61,47 @@ &spi2 {
+ 	pinctrl-0 = <&spi2_pins>;
+ 	pinctrl-1 = <&spi2_idle_pins>;
+ };
++
++&{/aliases} {
++	touchscreen0 = &touchscreen;
++};
++
++&touchclk {
++	status = "okay";
++};
++
++&touch_analog_bias {
++	status = "okay";
++};
++
++&touch_analog {
++	status = "okay";
++};
++
++&touch_core {
++	status = "okay";
++};
++
++&spi2 {
++	status = "okay";
++
++	touchscreen: touchscreen@0 {
++		compatible = "apple,j72-touchscreen";
++		reg = <0>;
++		spi-max-frequency = <1000000>;
++		interrupt-parent = <&pinctrl>;
++		interrupts = <111 IRQ_TYPE_EDGE_FALLING>;
++		attn-gpios = <&pinctrl 111 GPIO_ACTIVE_LOW>;
++		reset-gpios = <&pinctrl 15 GPIO_ACTIVE_LOW>;
++		clocks = <&touchclk>;
++		ana-supply = <&touch_analog>;
++		core-supply = <&touch_core>;
++		pinctrl-names = "display-sync-active", "display-sync-inactive";
++		pinctrl-0 = <&touch_sync_active>;
++		pinctrl-1 = <&touch_sync_inactive>;
++		touchscreen-size-x = <14621>;
++		touchscreen-size-y = <19539>;
++		touchscreen-inverted-y;
++		firmware-name = "apple/j72-fwstart.z2fw";
++	};
++};
