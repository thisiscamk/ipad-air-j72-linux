+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:35:28 +0800
+Subject: [PATCH] regulator: apple-pmic-touch: refuse inherited D2089 rail
+ state
+
+Refuse firmware-enabled analog bias, analog LDO or core state before
+registering a D2089 regulator. This prevents adopting an unqualified
+supply through regulator-core enabled-state shortcuts or unused-supply
+cleanup. An unreadable initial state is also a probe failure.
+
+Assisted-by: LLM
+---
+ .../regulator/apple-pmic-touch-regulator.c    | 28 +++++++++++++++++++
+ 1 file changed, 28 insertions(+)
+
+diff --git a/drivers/regulator/apple-pmic-touch-regulator.c b/drivers/regulator/apple-pmic-touch-regulator.c
+index 8f27cd616..18e03c5a4 100644
+--- a/drivers/regulator/apple-pmic-touch-regulator.c
++++ b/drivers/regulator/apple-pmic-touch-regulator.c
+@@ -167,6 +167,28 @@ static const struct regulator_desc apple_chestnut_touch_hv = {
+ 	.off_on_delay = 1000,
+ };
+ 
++static int apple_d2089_touch_admit(struct regmap *map,
++				   const struct regulator_desc *desc)
++{
++	unsigned int mask, value;
++	int ret;
++
++	if (desc == &apple_d2089_touch_bias)
++		mask = GENMASK(4, 0);
++	else if (desc == &apple_d2089_touch_analog ||
++		 desc == &apple_d2089_touch_core)
++		mask = desc->enable_mask;
++	else
++		return 0;
++
++	ret = regmap_read(map, desc->enable_reg, &value);
++	if (ret)
++		return ret;
++
++	/* Do not adopt a firmware-enabled supply without a handover policy. */
++	return value & mask ? -EBUSY : 0;
++}
++
+ static int apple_pmic_touch_regulator_probe(struct platform_device *pdev)
+ {
+ 	const struct regulator_desc *desc;
+@@ -174,6 +196,7 @@ static int apple_pmic_touch_regulator_probe(struct platform_device *pdev)
+ 	struct device *dev = &pdev->dev;
+ 	struct regulator_dev *rdev;
+ 	struct regmap *regmap;
++	int ret;
+ 
+ 	desc = device_get_match_data(dev);
+ 	if (!desc)
+@@ -184,6 +207,11 @@ static int apple_pmic_touch_regulator_probe(struct platform_device *pdev)
+ 		return dev_err_probe(dev, -ENODEV,
+ 				     "parent PMIC has no regmap\n");
+ 
++	ret = apple_d2089_touch_admit(regmap, desc);
++	if (ret)
++		return dev_err_probe(dev, ret,
++				     "touch supply initial state is not qualified\n");
++
+ 	config.dev = dev;
+ 	config.of_node = dev->of_node;
+ 	config.init_data = of_get_regulator_init_data(dev, dev->of_node, desc);
