+diff --git a/drivers/input/touchscreen/apple_z2_j72.h b/drivers/input/touchscreen/apple_z2_j72.h
+new file mode 100644
+index 000000000..e98838b5e
+--- /dev/null
++++ b/drivers/input/touchscreen/apple_z2_j72.h
+@@ -0,0 +1,210 @@
++/* SPDX-License-Identifier: GPL-2.0-only */
++#ifndef _APPLE_Z2_J72_H
++#define _APPLE_Z2_J72_H
++
++#include <linux/errno.h>
++#include <linux/string.h>
++#include <linux/types.h>
++#include <linux/unaligned.h>
++
++#define APPLE_Z2_J72_MAX_CONTACTS 10
++#define APPLE_Z2_J72_MAX_PAYLOAD 2454
++#define APPLE_Z2_J72_FW_PACKET_SIZE 57016
++#define APPLE_Z2_J72_RECOVERIES 6
++#define APPLE_Z2_J72_RECOVERY_MS 60000ULL
++
++struct apple_z2_j72_contact {
++	u8 id;
++	u8 state;
++	s16 x;
++	s16 y;
++};
++
++struct apple_z2_j72_recovery {
++	u64 times[APPLE_Z2_J72_RECOVERIES];
++	unsigned int count;
++	unsigned int next;
++};
++
++static inline bool apple_z2_j72_checksum(const u8 *p, size_t len)
++{
++	u16 sum = 0;
++	size_t i;
++
++	if (len < 2)
++		return false;
++	for (i = 0; i < len - 2; i++)
++		sum += p[i];
++	return sum == get_unaligned_le16(p + len - 2);
++}
++
++/* A valid E-class control reply is not necessarily an EB length reply. */
++static inline int apple_z2_j72_length(const u8 *p, u16 *length)
++{
++	unsigned int i;
++	bool zero = true;
++
++	for (i = 0; i < 14; i++)
++		zero &= !p[i];
++	if (zero)
++		return -EAGAIN;
++	if ((p[0] & 0xf0) != 0xe0 || !apple_z2_j72_checksum(p, 16))
++		return -EBADMSG;
++	if (p[0] != 0xe1)
++		return -EAGAIN;
++	*length = get_unaligned_le16(p + 1);
++	if (*length > APPLE_Z2_J72_MAX_PAYLOAD || (*length && *length < 2))
++		return -EMSGSIZE;
++	return 0;
++}
++
++static inline bool apple_z2_j72_packet(const u8 *p, size_t len)
++{
++	unsigned int header = 0;
++	unsigned int i;
++	u16 inner;
++
++	if (len < 7 || len > APPLE_Z2_J72_MAX_PAYLOAD + 5 ||
++	    (p[0] != 0xea && p[0] != 0xeb))
++		return false;
++	for (i = 0; i < 5; i++)
++		header += p[i];
++	inner = get_unaligned_le16(p + 2);
++	return !(header & 0xff) && inner >= 2 && (size_t)inner + 5 == len &&
++	       apple_z2_j72_checksum(p + 5, inner);
++}
++
++/* Validate the whole native report before the caller changes any input slot. */
++static inline int apple_z2_j72_contacts(const u8 *p, size_t len,
++				      struct apple_z2_j72_contact *out,
++				      unsigned int *count)
++{
++	unsigned int n, i, j;
++	const u8 *contact;
++
++	if (len < 24 || p[0] != 0x44)
++		return -EPROTO;
++	if (p[2] != 24 || get_unaligned_le16(p + 14) || p[17] != 30)
++		return -EPROTO;
++	n = p[16];
++	if (n > APPLE_Z2_J72_MAX_CONTACTS || n > (len - 24) / 30)
++		return -EMSGSIZE;
++	for (i = 0; i < n; i++) {
++		contact = p + 24 + i * 30;
++		switch (contact[1]) {
++		case 0:
++		case 1:
++		case 2:
++		case 3:
++		case 4:
++		case 5:
++		case 7:
++			break;
++		default:
++			return -EPROTO;
++		}
++		for (j = 0; j < i; j++)
++			if (out[j].id == contact[0])
++				return -EPROTO;
++		out[i].id = contact[0];
++		out[i].state = contact[1];
++		out[i].x = (s16)get_unaligned_le16(contact + 4);
++		out[i].y = (s16)get_unaligned_le16(contact + 6);
++	}
++	*count = n;
++	return 0;
++}
++
++static inline bool apple_z2_j72_recovery_admit(struct apple_z2_j72_recovery *r,
++					     u64 now)
++{
++	unsigned int last;
++
++	if (r->count > APPLE_Z2_J72_RECOVERIES ||
++	    r->next >= APPLE_Z2_J72_RECOVERIES)
++		return false;
++	last = (r->next + APPLE_Z2_J72_RECOVERIES - 1) % APPLE_Z2_J72_RECOVERIES;
++	if (r->count && now < r->times[last])
++		return false;
++	if (r->count == APPLE_Z2_J72_RECOVERIES &&
++	    now - r->times[r->next] < APPLE_Z2_J72_RECOVERY_MS)
++		return false;
++	r->times[r->next] = now;
++	r->next = (r->next + 1) % APPLE_Z2_J72_RECOVERIES;
++	if (r->count < APPLE_Z2_J72_RECOVERIES)
++		r->count++;
++	return true;
++}
++
++/* HBPP 0x103: full payload word count and two big-endian 16-bit halves. */
++static inline bool apple_z2_j72_blob(const u8 *p, size_t len, u32 address,
++				   unsigned int payload_size, bool zero)
++{
++	u16 header = 0;
++	u32 sum = 0;
++	unsigned int i;
++
++	if (len != payload_size + 16 || (payload_size & 3) ||
++	    get_unaligned_be16(p) != 0x18e1 ||
++	    get_unaligned_be16(p + 2) != 0x3001 ||
++	    get_unaligned_be16(p + 4) != payload_size / 4 ||
++	    get_unaligned_be16(p + 6) != (address & 0xffff) ||
++	    get_unaligned_be16(p + 8) != address >> 16)
++		return false;
++	for (i = 4; i < 10; i++)
++		header += p[i];
++	if (header != get_unaligned_be16(p + 10))
++		return false;
++	for (i = 12; i < 12 + payload_size; i++) {
++		if (zero && p[i])
++			return false;
++		sum += p[i];
++	}
++	return get_unaligned_be16(p + 12 + payload_size) == (sum & 0xffff) &&
++	       get_unaligned_be16(p + 14 + payload_size) == sum >> 16;
++}
++
++/* The normal Z2FW v1 ABI; no firmware bytes or owner calibration here. */
++static inline bool apple_z2_j72_firmware(const u8 *p, size_t len)
++{
++	static const u32 commands[] = { 4, 1, 6, 1 };
++	static const u32 sizes[] = { 44, 144, 12, APPLE_Z2_J72_FW_PACKET_SIZE };
++	size_t offset = 8;
++	unsigned int record, i;
++
++	if (len < 8 || get_unaligned_le32(p) != 0x5746325a ||
++	    get_unaligned_le32(p + 4) != 1)
++		return false;
++	for (record = 0; record < 4; record++) {
++		if (offset > len || len - offset < 8 ||
++		    get_unaligned_le32(p + offset) != commands[record] ||
++		    get_unaligned_le32(p + offset + 4) != sizes[record])
++			return false;
++		offset += 8;
++		if (sizes[record] > len - offset)
++			return false;
++		if (!record) {
++			for (i = 0; i < 11; i++) {
++				u32 expected = i == 0 ? 0x818 : i == 10 ? 0x103 : 0;
++
++				if (get_unaligned_le32(p + offset + i * 4) != expected)
++					return false;
++			}
++		} else if (record == 1) {
++			if (!apple_z2_j72_blob(p + offset, sizes[record],
++					       0x10009600, 128, true))
++				return false;
++		} else if (record == 2) {
++			if (get_unaligned_le32(p + offset) != 0x10009000 ||
++			    get_unaligned_le32(p + offset + 4) != 1024 ||
++			    get_unaligned_le32(p + offset + 8))
++				return false;
++		} else if (!apple_z2_j72_blob(p + offset, sizes[record], 0, 57000, false)) {
++			return false;
++		}
++		offset += sizes[record];
++	}
++	return offset == len;
++}
++
++#endif
diff --git a/kernel/patches/drivers/input/0021-dt-bindings-input-apple-z2-describe-the-J72-N1-contr.patch b/kernel/patches/drivers/input/0021-dt-bindings-input-apple-z2-describe-the-J72-N1-contr.patch
new file mode 100644
index 0000000..1bb9f7a
--- /dev/null
+++ b/kernel/patches/drivers/input/0021-dt-bindings-input-apple-z2-describe-the-J72-N1-contr.patch
@@ -0,0 +1,125 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:40:23 +0800
+Subject: [PATCH] dt-bindings: input: apple,z2: describe the J72 N1 controller
+
+Require the independent analog/core supplies, attention/reset pins, reference clock, display-sync states and measured portrait geometry. The bootloader supplies exactly 1024 bytes of nonblank unit calibration at runtime; static DTBs omit this private property.
+
+Remove the duplicate analog-supply key and retain its N61 applicability while allowing the new J72 resources. Preserve the existing J71t/J81 resource conditions.
+
+Assisted-by: LLM
+---
+ .../touchscreen/apple,z2-multitouch.yaml      | 69 +++++++++++++++++--
+ 1 file changed, 63 insertions(+), 6 deletions(-)
+
+diff --git a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
+index 0d508131f..495d16a7a 100644
+--- a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
++++ b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
