diff --git a/kernel/patches/drivers/input/0022-Input-apple_z2-bound-J72-power-faults-and-shutdown.patch b/kernel/patches/drivers/input/0022-Input-apple_z2-bound-J72-power-faults-and-shutdown.patch
new file mode 100644
index 0000000..fd1f3e6
--- /dev/null
+++ b/kernel/patches/drivers/input/0022-Input-apple_z2-bound-J72-power-faults-and-shutdown.patch
@@ -0,0 +1,184 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:52:04 +0800
+Subject: [PATCH] Input: apple_z2 - bound J72 power faults and shutdown
+
+Keep the J72 final-firmware and execute delays in N1 match data while preserving existing N1 defaults. Its dedicated worker owns runtime reads; never dispatch J72 through the other classic IRQ paths.
+
+A regulator enable failure may follow a physical write or regulator-core rollback. Latch this ambiguity and issue no further power operations or reference-clock release. Likewise, never retry a failed parent-supply disable. These flags do not preserve devm resources after framework unwind; a fault requires return to iOS without rebind or unload.
+
+Cancel both workers on stop, make successful J72 stops idempotent, propagate cleanup errors from suspend and add a J72 shutdown callback. Framework readback and shutdown behavior still require hardware qualification.
+
+Actual C fault fixtures cover applied-write enable failures, duplicate stop/shutdown, every transport phase, bounded health recovery and pre-power firmware/calibration refusal. ARM64 W=1 object build passes.
+
+Assisted-by: LLM
+---
+ drivers/input/touchscreen/apple_z2.c | 64 ++++++++++++++++++++++++----
+ 1 file changed, 56 insertions(+), 8 deletions(-)
+
+diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
+index 438d5a0a4..fc54fccff 100644
+--- a/drivers/input/touchscreen/apple_z2.c
++++ b/drivers/input/touchscreen/apple_z2.c
+@@ -159,6 +159,8 @@ struct apple_z2_hbpp_reg {
+  * @num_calib_regs:	number of entries in @calib_regs
+  * @execute_addr:	firmware entry point (fw-execute-addr)
+  * @execute_arg:	execute command argument
++ * @firmware_delay_ms:	delay before the final firmware packet
++ * @execute_delay_ms:	delay after execute; zero retains the 40 ms + 2 ms default
+  * @cal_size:		size of the unit's multi-touch calibration (MtCl)
+  * @cal_chunk_size:	largest calibration payload per HBPP packet
+  * @control_delay_us:	delay between the two phases of a control command
+@@ -179,6 +181,8 @@ struct apple_z2_n1_info {
+ 	unsigned int num_calib_regs;
+ 	u32 execute_addr;
+ 	u32 execute_arg;
++	unsigned int firmware_delay_ms;
++	unsigned int execute_delay_ms;
+ 	unsigned int cal_size;
+ 	unsigned int cal_chunk_size;
+ 	unsigned int control_delay_us;
+@@ -2269,6 +2273,8 @@ static irqreturn_t apple_z2_irq(int irq, void *data)
+ 	struct apple_z2 *z2 = data;
+ 	int error;
+ 
++	if (apple_z2_is_j72(z2))
++		return IRQ_HANDLED;
+ 	if (unlikely(!z2->booted)) {
+ 		complete(&z2->boot_irq);
+ 	} else if (apple_z2_is_j71t(z2)) {
+@@ -3241,8 +3247,12 @@ static int apple_z2_n1_start_firmware(struct apple_z2 *z2)
+ 	error = apple_z2_hbpp_xfer(z2, 12);
+ 	if (error)
+ 		return error;
+-	msleep(40);
+-	usleep_range(2000, 3000);
++	if (n1->execute_delay_ms) {
++		msleep(n1->execute_delay_ms);
++	} else {
++		msleep(40);
++		usleep_range(2000, 3000);
++	}
+ 
+ 	return 0;
+ }
+@@ -3664,6 +3674,10 @@ static int apple_z2_upload_firmware(struct apple_z2 *z2)
+ 			if (size > fw->size - fw_idx)
+ 				return -EINVAL;
+ 			if (apple_z2_uses_n1(z2)) {
++				if (z2->info->n1->firmware_delay_ms &&
++				    size == fw->size - fw_idx)
++					usleep_range(z2->info->n1->firmware_delay_ms * 1000,
++						     z2->info->n1->firmware_delay_ms * 1000 + 1000);
+ 				error = apple_z2_hbpp_send(z2, blob, size);
+ 				if (error)
+ 					return error;
+@@ -4181,6 +4195,10 @@ static void apple_z2_j72_power_off(struct apple_z2 *z2)
+ {
+ 	int error;
+ 
++	/* A parent-supply failure can already have dropped a child use count. */
++	if (z2->j72_power_error)
++		return;
++
+ 	error = gpiod_set_value_cansleep(z2->reset_gpio, 1);
+ 	if (error)
+ 		goto failed;
+@@ -4209,7 +4227,7 @@ static void apple_z2_j72_power_off(struct apple_z2 *z2)
+ failed:
+ 	z2->j72_power_error = error;
+ 	dev_err(&z2->spidev->dev,
+-		"J72 stop failed: %d; retaining remaining supply/clock owners\n", error);
++		"J72 cleanup failed: %d; power operations halted until reboot\n", error);
+ }
+ 
+ static int apple_z2_j72_power_on(struct apple_z2 *z2)
+@@ -4233,11 +4251,11 @@ static int apple_z2_j72_power_on(struct apple_z2 *z2)
+ 		return error;
+ 	error = regulator_enable(z2->ana_supply);
+ 	if (error)
+-		goto stop;
++		goto ambiguous;
+ 	z2->ana_enabled = true;
+ 	error = regulator_enable(z2->core_supply);
+ 	if (error)
+-		goto stop;
++		goto ambiguous;
+ 	z2->core_enabled = true;
+ 	usleep_range(15000, 16000);
+ 	z2->tx_buf[0] = 0x19;
+@@ -4259,6 +4277,14 @@ static int apple_z2_j72_power_on(struct apple_z2 *z2)
+ 	z2->platform_powered = true;
+ 	return 0;
+ 
++ambiguous:
++	/* A failed verification can follow a physical write and core rollback. */
++	z2->j72_power_error = error;
++	dev_err(&z2->spidev->dev,
++		"J72 supply enable failed: %d; physical state unverified, no further power I/O\n",
++		error);
++	return error;
++
+ stop:
+ 	apple_z2_j72_power_off(z2);
+ 	return error;
+@@ -4672,6 +4698,8 @@ static const struct apple_z2_n1_info apple_z2_j72_n1 = {
+ 	.num_calib_regs = ARRAY_SIZE(apple_z2_j71t_calib_regs),
+ 	.execute_addr = 0x10003400,
+ 	.execute_arg = 0x100,
++	.firmware_delay_ms = 15,
++	.execute_delay_ms = 100,
+ 	.cal_size = 0x400,
+ 	.cal_chunk_size = 0x3f0,
+ 	.control_delay_us = 25,
+@@ -4989,8 +5017,18 @@ static void apple_z2_stop(struct apple_z2 *z2)
+ 	mutex_unlock(&z2->io_lock);
+ 	if (irq_on)
+ 		disable_irq(z2->spidev->irq);
+-	if (apple_z2_is_j72(z2))
++	if (apple_z2_is_j72(z2)) {
++		z2->booted = false;
++		/* A failed parent disable must not be retried or rebalanced. */
++		if (z2->j72_power_error ||
++		    (!z2->platform_powered && !z2->clk_enabled &&
++		     !z2->ana_enabled && !z2->core_enabled))
++			return;
+ 		apple_z2_release_contacts(z2);
++		apple_z2_j72_power_off(z2);
++		apple_z2_reset_protocol(z2);
++		return;
++	}
+ 	gpiod_direction_output(z2->reset_gpio, 1);
+ 	z2->booted = false;
+ 	apple_z2_platform_power_off(z2);
+@@ -5002,11 +5040,20 @@ static void apple_z2_remove(struct spi_device *spi)
+ 	apple_z2_stop(spi_get_drvdata(spi));
+ }
+ 
++static void apple_z2_shutdown(struct spi_device *spi)
++{
++	struct apple_z2 *z2 = spi_get_drvdata(spi);
++
++	if (apple_z2_is_j72(z2))
++		apple_z2_stop(z2);
++}
++
+ static int apple_z2_suspend(struct device *dev)
+ {
+-	apple_z2_stop(spi_get_drvdata(to_spi_device(dev)));
++	struct apple_z2 *z2 = spi_get_drvdata(to_spi_device(dev));
+ 
+-	return 0;
++	apple_z2_stop(z2);
++	return apple_z2_is_j72(z2) ? z2->j72_power_error : 0;
+ }
+ 
+ static int apple_z2_resume(struct device *dev)
+@@ -5060,6 +5107,7 @@ static struct spi_driver apple_z2_driver = {
+ 	.id_table = apple_z2_of_id,
+ 	.probe    = apple_z2_probe,
+ 	.remove   = apple_z2_remove,
++	.shutdown = apple_z2_shutdown,
+ };
+ 
+ module_spi_driver(apple_z2_driver);
