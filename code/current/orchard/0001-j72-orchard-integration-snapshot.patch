+       - apple,j172-touchscreen
+       - apple,d11-touchscreen
+@@ -46,7 +47,8 @@ properties:
+   ana-supply:
+     description:
+       Analog supply for the touchscreen controller, where a PMIC switch
+-      rather than a GPIO provides it
++      rather than a GPIO provides it. On N61 this is the Chestnut
++      high-voltage switch
+ 
+   hv-supply:
+     description: High-voltage analog supply for the touchscreen controller
+@@ -67,9 +69,6 @@ properties:
+   clocks:
+     maxItems: 1
+ 
+-  ana-supply:
+-    description: N61 analog touchscreen supply from the Chestnut high-voltage switch
+-
+   apple,z2-prox-cal-blob:
+     $ref: /schemas/types.yaml#/definitions/uint8-array
+     maxItems: 128
+@@ -95,8 +94,8 @@ properties:
+     maxItems: 4096
+     description:
+       Calibration blob supplied by the bootloader. N61 requires this
+-      per-unit data at driver probe; it can be absent from a static DTB
+-      before the bootloader adds it.
++      per-unit data at driver probe; J72 requires exactly 1024 bytes. It
++      can be absent from a static DTB before the bootloader adds it.
+ 
+   apple,z2-orb-gap-cal-blob:
+     $ref: /schemas/types.yaml#/definitions/uint8-array
+@@ -202,9 +201,67 @@ allOf:
