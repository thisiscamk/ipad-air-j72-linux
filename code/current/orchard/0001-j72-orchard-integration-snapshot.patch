@@ -0,0 +1,132 @@
+"""Exercise recovery admission and refusal without loading host storage modules."""
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class StorageFence(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        spec = importlib.util.spec_from_file_location('j72_storage', ROOT / 'runtime/recovery/storage-j72.py')
+        self.fence = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(self.fence)
+        for name in ('COMPATIBLE', 'MOUNTINFO', 'SYS_BLOCK', 'DEV', 'RUN'):
+            setattr(self.fence, name, self.root / name.lower())
+        self.fence.COMPATIBLE.write_bytes(b'apple,j72\0apple,s5l8960x\0')
+        self.fence.MOUNTINFO.write_text('1 0 0:1 / / rw - tmpfs tmpfs rw\n')
+        for path in (self.fence.SYS_BLOCK, self.fence.DEV):
+            path.mkdir()
+        self.block('asp0n1', '0', '240:0')
+        self.block('asp0n1p1', '0', '240:1', partition=True)
+        self.block('asp0n2', '0', '240:2')
+        self.process = Mock(pid=12345, returncode=0)
+        self.process.poll.return_value = 0
+        self.commands = []
+        def command(*argv):
+            # Simulate the block layer's setro response; assert admission
+            # never offers readiness before every actual block is fenced.
+            self.assertFalse((self.fence.RUN / 'storage-ready').exists())
+            self.commands.append(argv)
+            self.assertEqual(argv[:2], ('blockdev', '--setro'))
+            (self.fence.SYS_BLOCK / Path(argv[2]).name / 'ro').write_text('1\n')
+        for p in (patch.object(self.fence.subprocess, 'Popen', return_value=self.process),
+                  patch.object(self.fence, 'command', side_effect=command),
+                  patch.object(Path, 'is_block_device', return_value=True)):
+            p.start()
+            self.addCleanup(p.stop)
+        self.fence.MODULE_SECONDS = self.fence.DEVICE_SECONDS = 0
+
+    def block(self, name, ro, number, partition=False):
+        block = self.fence.SYS_BLOCK / name
+        (block / 'holders').mkdir(parents=True)
+        (block / 'queue').mkdir()
+        (block / 'queue/logical_block_size').write_text('4096\n')
+        (block / 'ro').write_text(ro + '\n')
+        (block / 'dev').write_text(number + '\n')
+        if partition:
+            (block / 'partition').write_text('1\n')
+
+    def result(self):
+        return json.loads((self.fence.RUN / 'j72-asp-storage.json').read_text())
+
+    def refused(self, reason):
+        self.assertEqual(self.fence.main(), 1)
+        self.assertFalse((self.fence.RUN / 'storage-ready').exists())
+        self.assertEqual(self.result()['status'], 'READINESS_REFUSED')
+        self.assertIn(reason, self.result()['error'])
+
+    def test_success_fences_retained_partition_and_auxiliary_not_user_disk(self):
+        self.assertEqual(self.fence.main(), 0)
+        self.assertEqual([Path(c[2]).name for c in self.commands], ['asp0n1p1', 'asp0n2'])
+        self.assertEqual((self.fence.SYS_BLOCK / 'asp0n1/ro').read_text(), '0\n')
+        self.assertEqual((self.fence.RUN / 'storage-ready').read_text(), 'ready\n')
+        self.assertEqual(self.result()['status'], 'READY')
+
+    def test_readonly_diagnostic_provider_cannot_enable_installation(self):
+        (self.fence.SYS_BLOCK / 'asp0n1/ro').write_text('1\n')
+        self.refused('read-only')
+        self.assertEqual(self.commands, [])
+
+    def test_missing_partitions_cannot_enable_installation(self):
+        (self.fence.SYS_BLOCK / 'asp0n1p1/partition').unlink()
+        self.refused('partition discovery')
+        self.assertEqual(self.commands, [])
+
+    def test_pending_module_preserves_same_actor_and_forbids_retry(self):
+        self.process.poll.return_value = None
+        self.refused('still pending at PID 12345')
+        self.assertFalse(self.result()['module_terminal'])
+        first = (self.fence.RUN / 'j72-asp-storage.json').read_bytes()
+        self.assertEqual(self.fence.main(), 1)
+        self.assertEqual((self.fence.RUN / 'j72-asp-storage.json').read_bytes(), first)
+        self.fence.subprocess.Popen.assert_called_once()
+        self.process.kill.assert_not_called()
+        self.process.terminate.assert_not_called()
+
+    def test_similar_board_never_loads_asp(self):
+        self.fence.COMPATIBLE.write_bytes(b'apple,j72b\0')
+        self.refused('requires the J72')
+        self.fence.subprocess.Popen.assert_not_called()
+
+    def test_mount_alias_device_number_refuses_before_module_load(self):
+        self.fence.MOUNTINFO.write_text('2 1 240:1 / /mnt ro - apfs /dev/retained-alias ro\n')
+        self.refused('already mounted')
+        self.fence.subprocess.Popen.assert_not_called()
+
+    def test_block_holder_refuses_before_module_load(self):
+        (self.fence.SYS_BLOCK / 'asp0n1/holders/loop0').touch()
+        self.refused('active block holder')
+        self.fence.subprocess.Popen.assert_not_called()
+
+    def test_new_mount_during_module_load_refuses_before_setro(self):
+        def poll():
+            self.fence.MOUNTINFO.write_text('2 1 240:1 / /mnt ro - apfs /dev/asp0n1p1 ro\n')
+            return 0
+        self.process.poll.side_effect = poll
+        self.refused('already mounted')
+        self.assertEqual(self.commands, [])
+
+    def test_fence_readback_failure_never_claims_readiness(self):
+        self.fence.command.side_effect = lambda *args: None
+        self.refused('Could not fence ASP partition')
+
+    def test_recovery_packages_helper_and_keeps_other_board_fence(self):
+        from orchard.image.runtime import recovery_files
+        files = recovery_files()
+        self.assertEqual(files['usr/libexec/orchard/storage-j72.py'],
+                         ((ROOT / 'runtime/recovery/storage-j72.py').read_bytes(), 0o755))
+        body = files['usr/libexec/orchard/storage-fence'][0].decode()
+        self.assertIn("grep -qx 'apple,j72'", body)
+        self.assertIn('exec python3 /usr/libexec/orchard/storage-j72.py', body)
+        self.assertIn('modprobe nvme\n', body)
+
+
+if __name__ == '__main__':
+    unittest.main()
