++	.ops = &apple_d2089_touch_regulator_ops,
+ 	.type = REGULATOR_VOLTAGE,
+ 	.owner = THIS_MODULE,
+ 	.enable_reg = 0x84,
+@@ -71,7 +122,7 @@ static const struct regulator_desc apple_d2089_touch_analog = {
+ 
+ static const struct regulator_desc apple_d2089_touch_core = {
+ 	.name = "d2089-touch-core",
+-	.ops = &apple_pmic_touch_regulator_ops,
