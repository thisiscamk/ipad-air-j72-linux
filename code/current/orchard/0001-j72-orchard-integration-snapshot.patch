diff --git a/kernel/patches/devices/s5l8960x/0002-arm64-dts-apple-connect-the-J72-N1-touchscreen-resou.patch b/kernel/patches/devices/s5l8960x/0002-arm64-dts-apple-connect-the-J72-N1-touchscreen-resou.patch
