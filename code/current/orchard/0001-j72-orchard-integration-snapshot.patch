diff --git a/kernel/patches/drivers/regulator/0008-regulator-apple-pmic-touch-add-D2089-supplies-and-sh.patch b/kernel/patches/drivers/regulator/0008-regulator-apple-pmic-touch-add-D2089-supplies-and-sh.patch
new file mode 100644
index 0000000..358719d
--- /dev/null
+++ b/kernel/patches/drivers/regulator/0008-regulator-apple-pmic-touch-add-D2089-supplies-and-sh.patch
@@ -0,0 +1,111 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:28:57 +0800
+Subject: [PATCH] regulator: apple-pmic-touch: add D2089 supplies and shared
+ bias
+
+The D2089 analog rail uses register 0x84 bit 2 and requires shared bits 0 and 1. Represent the dependency through the regulator supply relationship so users are counted and the last modelled user can turn it off. Refuse bias shutdown while any analog LDO in bits 2 through 4 remains enabled. The separate touchscreen core switch is register 0x85 bit 1. Preserve voltage registers and all unrelated bits.
+
+Assisted-by: LLM
+---
+ .../regulator/apple-pmic-touch-regulator.c    | 73 +++++++++++++++++++
+ 1 file changed, 73 insertions(+)
+
+diff --git a/drivers/regulator/apple-pmic-touch-regulator.c b/drivers/regulator/apple-pmic-touch-regulator.c
+index 6984db4fc..8f27cd616 100644
+--- a/drivers/regulator/apple-pmic-touch-regulator.c
++++ b/drivers/regulator/apple-pmic-touch-regulator.c
+@@ -5,6 +5,7 @@
+  * Copyright (C) 2026 Paul Praschl
+  */
+ 
++#include <linux/bits.h>
+ #include <linux/module.h>
+ #include <linux/of.h>
+ #include <linux/platform_device.h>
+@@ -19,6 +20,66 @@ static const struct regulator_ops apple_pmic_touch_regulator_ops = {
+ 	.is_enabled = regulator_is_enabled_regmap,
+ };
+ 
++/*
++ * D2089 LDOs 13..15 share the low two analog-bias bits at 0x84.
++ * Model that dependency as a supply so the regulator core accounts for
++ * users. Refuse to turn off the bias if an unmodelled LDO is still on.
++ */
++static int apple_d2089_touch_bias_disable(struct regulator_dev *rdev)
++{
++	struct regmap *map = rdev_get_regmap(rdev);
++	unsigned int value;
++	int ret;
++
++	ret = regmap_read(map, 0x84, &value);
++	if (ret)
++		return ret;
++	if (value & GENMASK(4, 2))
++		return -EBUSY;
++
++	return regulator_disable_regmap(rdev);
++}
++
++static const struct regulator_ops apple_d2089_touch_bias_ops = {
++	.enable = regulator_enable_regmap,
++	.disable = apple_d2089_touch_bias_disable,
++	.is_enabled = regulator_is_enabled_regmap,
++};
++
++static const struct regulator_desc apple_d2089_touch_bias = {
++	.name = "d2089-touch-analog-bias",
++	.ops = &apple_d2089_touch_bias_ops,
++	.type = REGULATOR_VOLTAGE,
++	.owner = THIS_MODULE,
++	.enable_reg = 0x84,
++	.enable_mask = 0x03,
++	.enable_val = 0x03,
++	.disable_val = 0,
++};
++
++static const struct regulator_desc apple_d2089_touch_analog = {
++	.name = "d2089-touch-analog",
++	.supply_name = "bias",
++	.ops = &apple_pmic_touch_regulator_ops,
++	.type = REGULATOR_VOLTAGE,
++	.owner = THIS_MODULE,
++	.enable_reg = 0x84,
++	.enable_mask = 0x04,
++	.enable_val = 0x04,
++	.disable_val = 0,
++};
++
++static const struct regulator_desc apple_d2089_touch_core = {
++	.name = "d2089-touch-core",
++	.ops = &apple_pmic_touch_regulator_ops,
++	.type = REGULATOR_VOLTAGE,
++	.owner = THIS_MODULE,
++	.enable_reg = 0x85,
++	.enable_mask = 0x02,
