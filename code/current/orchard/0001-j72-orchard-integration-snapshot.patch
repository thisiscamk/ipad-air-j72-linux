+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:28:58 +0800
+Subject: [PATCH] dt-bindings: clock: describe S5L8960X touch reference output
+
+Describe the PWM0 channel 2 reference clock separately from the later FPWM block and the PMGR touch dividers.
+
+Assisted-by: LLM
+---
+ .../clock/apple,s5l8960x-touch-clock.yaml     | 56 +++++++++++++++++++
+ 1 file changed, 56 insertions(+)
+ create mode 100644 Documentation/devicetree/bindings/clock/apple,s5l8960x-touch-clock.yaml
+
+diff --git a/Documentation/devicetree/bindings/clock/apple,s5l8960x-touch-clock.yaml b/Documentation/devicetree/bindings/clock/apple,s5l8960x-touch-clock.yaml
+new file mode 100644
+index 000000000..c3845b550
+--- /dev/null
++++ b/Documentation/devicetree/bindings/clock/apple,s5l8960x-touch-clock.yaml
+@@ -0,0 +1,56 @@
++# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/clock/apple,s5l8960x-touch-clock.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: Apple S5L8960X touchscreen reference clock
++
++maintainers:
++  - asahi@lists.linux.dev
++
++description:
++  PWM0 channel 2 generates the touchscreen reference clock. Its count and
++  control register layout differs from the later Apple FPWM block. The
++  clock is nominally 32768 Hz, rounded to an even number of reference-clock
++  cycles for a symmetric waveform. Other PWM channels are not described.
++
++properties:
++  compatible:
++    const: apple,s5l8960x-touch-clock
++
++  reg:
++    maxItems: 1
++
++  clocks:
++    maxItems: 1
++
++  power-domains:
++    maxItems: 1
++
++  '#clock-cells':
++    const: 0
++
++  clock-frequency:
++    const: 32768
++
++required:
++  - compatible
++  - reg
++  - clocks
++  - power-domains
++  - '#clock-cells'
++  - clock-frequency
++
++additionalProperties: false
++
++examples:
++  - |
++    clock-controller@a118000 {
++        compatible = "apple,s5l8960x-touch-clock";
++        reg = <0x0a118000 0x4000>;
++        clocks = <&clkref>;
++        power-domains = <&ps_pwm0>;
++        #clock-cells = <0>;
++        clock-frequency = <32768>;
++    };
