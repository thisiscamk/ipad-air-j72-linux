diff --git a/drivers/power/supply/j72_charge_maintain.c b/drivers/power/supply/j72_charge_maintain.c
index 2af7c2eb0..17dc2ca5b 100644
--- a/drivers/power/supply/j72_charge_maintain.c
+++ b/drivers/power/supply/j72_charge_maintain.c
@@ -49,6 +49,7 @@ static u64 guard_at_ms, guard_failed_at_ms;
 static unsigned int read_failures, fresh_refreshes, read_recoveries;
 static int last_read_errno, last_failed_prop;
 static u64 last_read_failure_ms;
+static unsigned int cache_lock_waits;
 
 static void deadline_fn(struct work_struct *work);
 static void guard_fn(struct work_struct *work);
@@ -157,9 +158,15 @@ static int pack_values(int *values)
  int ret = -EIO;
  struct bq27xxx_device_info *di = power_supply_get_drvdata(battery);
  /* A cached property can be readable even if its worker stopped. Do not
-  * turn that old vector into a new charge-policy timestamp. Never wait
-  * for the gauge lock here; the independent deadline keeps restoring. */
- if (!di || !mutex_trylock(&di->lock)) return -EBUSY;
+  * turn that old vector into a new charge-policy timestamp. A normal
+  * refresh holds this lock during HDQ. Wait only on the gauge worker,
+  * outside policy_lock; the independent deadline still restores on
+  * stale samples. Check freshness after acquiring the cache lock. */
+ if (!di) return -ENODEV;
+ if (!mutex_trylock(&di->lock)) {
+  WRITE_ONCE(cache_lock_waits, READ_ONCE(cache_lock_waits) + 1);
+  mutex_lock(&di->lock);
+ }
  if (di->cache_only && (!di->last_update ||
      time_after_eq(jiffies, di->last_update +
                    msecs_to_jiffies(J72_GAUGE_MAX_AGE_MS)))) ret = -ETIMEDOUT;
@@ -409,9 +416,9 @@ static int status_get(char *buf, const struct kernel_param *unused)
 		guard_failed_values[0], guard_failed_values[1], guard_failed_values[2],
 		guard_failed_values[3], guard_failed_values[4]);
  n += scnprintf(buf + n, PAGE_SIZE - n,
-  "read_failures=%u\nfresh_refreshes=%u\nread_recoveries=%u\nlast_read_errno=%d\nlast_failed_prop=%d\nlast_read_failure_ms=%llu\n",
+  "read_failures=%u\nfresh_refreshes=%u\nread_recoveries=%u\nlast_read_errno=%d\nlast_failed_prop=%d\nlast_read_failure_ms=%llu\ncache_lock_waits=%u\n",
   read_failures, fresh_refreshes, read_recoveries, last_read_errno,
-  last_failed_prop, (unsigned long long)last_read_failure_ms);
+  last_failed_prop, (unsigned long long)last_read_failure_ms, READ_ONCE(cache_lock_waits));
  n += scnprintf(buf+n,PAGE_SIZE-n,
   "enabled=%u\nfault=%u\nmode=%u\ncycles=%u\npauses=%u\ncontroller_error=%d\nsample_at_ms=%llu\n",
   maintain.enabled,maintain.fault,maintain.mode,maintain.cycles,maintain.pauses,
