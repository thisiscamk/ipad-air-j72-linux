+static int apple_d2089_touch_update(struct regulator_dev *rdev, bool enable)
+{
+	const struct regulator_desc *desc = rdev->desc;
+	unsigned int value, expected = enable ? desc->enable_val : 0;
+	int ret;
+
+	ret = enable ? regulator_enable_regmap(rdev) :
+		       regulator_disable_regmap(rdev);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_bypassed(rdev_get_regmap(rdev), desc->enable_reg, &value);
+	if (ret)
+		return ret;
+
+	return (value & desc->enable_mask) == expected ? 0 : -EIO;
+}
+
+static int apple_d2089_touch_enable(struct regulator_dev *rdev)
+{
+	return apple_d2089_touch_update(rdev, true);
+}
+
+static int apple_d2089_touch_disable(struct regulator_dev *rdev)
+{
+	return apple_d2089_touch_update(rdev, false);
+}
+
+static int apple_d2089_touch_is_enabled(struct regulator_dev *rdev)
+{
+	const struct regulator_desc *desc = rdev->desc;
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read_bypassed(rdev_get_regmap(rdev), desc->enable_reg, &value);
+	if (ret)
+		return ret;
+
+	value &= desc->enable_mask;
+	if (!value)
+		return 0;
+
+	return value == desc->enable_val ? 1 : -EIO;
+}
+
+static const struct regulator_ops apple_d2089_touch_regulator_ops = {
+	.enable = apple_d2089_touch_enable,
+	.disable = apple_d2089_touch_disable,
+	.is_enabled = apple_d2089_touch_is_enabled,
+};
