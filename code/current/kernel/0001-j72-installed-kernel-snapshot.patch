 };
+
+&pinctrl {
+	spi2_pins: spi2-pins {
+		pinmux = <APPLE_PINMUX(76, 1)>,
+			 <APPLE_PINMUX(77, 1)>,
+			 <APPLE_PINMUX(78, 1)>,
