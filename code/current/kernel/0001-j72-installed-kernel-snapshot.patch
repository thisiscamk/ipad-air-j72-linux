+
+	touch_sync_active: touch-sync-active-pins {
+		pinmux = <APPLE_PINMUX(119, 1)>;
+	};
+
+	touch_sync_inactive: touch-sync-inactive-pins {
+		pinmux = <APPLE_PINMUX(119, 0)>;
+	};
+};
+
+&{/soc/i2c@20a110000/pmic@3c} {
+	touch_analog_bias: regulator-touch-analog-bias {
+		compatible = "apple,d2089-touch-analog-bias-regulator";
+		regulator-name = "touch-analog-bias";
+		status = "disabled";
+	};
+
+	touch_analog: regulator-touch-analog {
+		compatible = "apple,d2089-touch-analog-regulator";
+		regulator-name = "touch-analog";
+		status = "disabled";
+		bias-supply = <&touch_analog_bias>;
+	};
+
+	touch_core: regulator-touch-core {
+		compatible = "apple,d2089-touch-core-regulator";
+		regulator-name = "touch-core";
+		status = "disabled";
+	};
+};
+
+/* The consumer enables these resources only in the touchscreen topic. */
+&spi2 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&spi2_pins>;
+	pinctrl-1 = <&spi2_idle_pins>;
+};
+
+&{/aliases} {
+	touchscreen0 = &touchscreen;
+};
+
+&touchclk {
+	status = "okay";
+};
+
+&touch_analog_bias {
+	status = "okay";
+};
+
+&touch_analog {
+	status = "okay";
+};
+
+&touch_core {
+	status = "okay";
+};
+
+&spi2 {
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,j72-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <1000000>;
+		interrupt-parent = <&pinctrl>;
+		interrupts = <111 IRQ_TYPE_EDGE_FALLING>;
+		attn-gpios = <&pinctrl 111 GPIO_ACTIVE_LOW>;
+		reset-gpios = <&pinctrl 15 GPIO_ACTIVE_LOW>;
+		clocks = <&touchclk>;
+		ana-supply = <&touch_analog>;
+		core-supply = <&touch_core>;
+		pinctrl-names = "display-sync-active", "display-sync-inactive";
+		pinctrl-0 = <&touch_sync_active>;
+		pinctrl-1 = <&touch_sync_inactive>;
+		touchscreen-size-x = <14621>;
+		touchscreen-size-y = <19539>;
+		touchscreen-inverted-y;
+		firmware-name = "apple/j72-fwstart.z2fw";
+	};
+};
+
+/* Reserved RAM is filled from the live ADT by the recovery loader. */
+&{/reserved-memory} {
+	ans_firmware: ans-firmware {
+		reg = <0 0 0 0>;
+		no-map;
+	};
+};
+
+&{/aliases} {
+	asp = &ans;
+};
+
+&ps_ans {
+	apple,always-on;
+};
+
+&ans_mbox {
+	status = "okay";
+};
+
+&ans {
+	memory-region = <&ans_firmware>;
+	memory-region-names = "firmware";
+	status = "okay";
+};
+
+&{/soc} {
+	uart5: serial@20a0b4000 {
+		compatible = "apple,s5l-uart";
+		reg = <0x2 0x0a0b4000 0 0x4000>;
+		reg-io-width = <4>;
+		interrupts = <AIC_IRQ 0x91 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart5>;
+		status = "okay";
+
+		battery {
+			compatible = "ti,bq27540-hdq-uart";
+		};
+	};
+};
