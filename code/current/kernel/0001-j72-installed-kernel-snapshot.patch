+/* J72 supplies and the reference clock have independent native providers. */
+static void apple_z2_j72_power_off(struct apple_z2 *z2)
+{
+	int error;
+
+	/* A parent-supply failure can already have dropped a child use count. */
+	if (z2->j72_power_error)
+		return;
+
+	error = gpiod_set_value_cansleep(z2->reset_gpio, 1);
+	if (error)
+		goto failed;
+	error = pinctrl_select_state(z2->sync_pinctrl, z2->sync_inactive);
+	if (error)
+		goto failed;
+	if (z2->core_enabled) {
+		error = regulator_disable(z2->core_supply);
+		if (error)
+			goto failed;
+		z2->core_enabled = false;
+	}
+	if (z2->ana_enabled) {
+		error = regulator_disable(z2->ana_supply);
+		if (error)
+			goto failed;
+		z2->ana_enabled = false;
+	}
+	if (z2->clk_enabled) {
+		clk_disable_unprepare(z2->clk);
+		z2->clk_enabled = false;
+	}
+	z2->platform_powered = false;
+	return;
+
+failed:
+	z2->j72_power_error = error;
+	dev_err(&z2->spidev->dev,
+		"J72 cleanup failed: %d; power operations halted until reboot\n", error);
+}
+
+static int apple_z2_j72_power_on(struct apple_z2 *z2)
+{
+	int error;
+
+	if (z2->j72_power_error)
+		return z2->j72_power_error;
+	/* Never acquire and later disable a supply inherited from iOS. */
+	error = regulator_is_enabled(z2->ana_supply);
+	if (error)
+		return error < 0 ? error : -EBUSY;
+	error = regulator_is_enabled(z2->core_supply);
+	if (error)
+		return error < 0 ? error : -EBUSY;
+	error = gpiod_set_value_cansleep(z2->reset_gpio, 1);
+	if (error)
+		return error;
+	error = apple_z2_enable_clock(z2);
+	if (error)
+		return error;
+	error = regulator_enable(z2->ana_supply);
+	if (error)
+		goto ambiguous;
+	z2->ana_enabled = true;
+	error = regulator_enable(z2->core_supply);
+	if (error)
+		goto ambiguous;
+	z2->core_enabled = true;
+	usleep_range(15000, 16000);
+	z2->tx_buf[0] = 0x19;
+	z2->tx_buf[1] = 0xc1;
+	error = apple_z2_hbpp_xfer(z2, 2);
+	if (error)
+		goto stop;
+	error = pinctrl_select_state(z2->sync_pinctrl, z2->sync_active);
+	if (error)
+		goto stop;
+	usleep_range(10000, 11000);
+	error = apple_z2_hbpp_nop(z2);
+	if (error)
+		goto stop;
+	error = gpiod_set_value_cansleep(z2->reset_gpio, 0);
+	if (error)
+		goto stop;
+	msleep(30);
+	z2->platform_powered = true;
+	return 0;
+
+ambiguous:
+	/* A failed verification can follow a physical write and core rollback. */
+	z2->j72_power_error = error;
+	dev_err(&z2->spidev->dev,
+		"J72 supply enable failed: %d; physical state unverified, no further power I/O\n",
+		error);
+	return error;
+
+stop:
+	apple_z2_j72_power_off(z2);
+	return error;
+}
