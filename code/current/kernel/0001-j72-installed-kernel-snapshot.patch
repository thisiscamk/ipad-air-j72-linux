new file mode 100644
index 000000000..6e433414f
--- /dev/null
+++ b/drivers/power/supply/bq27xxx_battery_hdq_uart.c
@@ -0,0 +1,470 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * TI HDQ battery gauge over Apple UART5, bit-banged via serdev
+ *
+ * Derived from mattonik/ipad-nixos commit b94d42f78e04c5465e290340a5b6879bbc5956b6.
+ * J72 adaptation: AP GPIO44 inherited function1, verified DEVICE_TYPE0545.
+ * No PMU GPIO switching. Writes are limited to volatile DEVICE_TYPE query.
+ *
+ * J81 (iPad Air 2 Wi-Fi) wires its BQ2754x-family gas gauge to a single
+ * AP GPIO pin (AP GPIO34) shared as UART5 TX, encoding TI's single-wire
+ * HDQ protocol as UART bytes rather than exposing a real HDQ/1-Wire
+ * master. See docs/plans/2026-09-08-j81-bluetooth-battery-adt.md and
+ * research/j81-battery-hdq.md for the wiring evidence and protocol
+ * analysis this driver implements. drivers/power/supply/bq27xxx_battery_hdq.c
+ * is a different transport (a real Linux 1-Wire master) and does not
+ * apply here.
+ *
+ * Wire encoding (matches the behavior documented for this exact wiring):
+ *   - one HDQ bit = one UART byte: 0xfe = HDQ one, 0xc0 = HDQ zero;
+ *   - one HDQ byte = eight UART bytes, sent/received LSB first;
+ *   - the bus is a single wire, so our own transmitted bytes loop back
+ *     on RX before the gauge's response bytes do -- every transaction
+ *     reads and discards that echo first;
+ *   - each transaction opens with an HDQ break (a low pulse) which,
+ *     unlike a normal UART break, needs microsecond-precision timing
+ *     that the tty layer's own break_ctl() does not provide, so this
+ *     driver asserts/times/deasserts it manually instead of trusting
+ *     a fixed-duration break request.
+ */
+
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/power/bq27xxx_battery.h>
+#include <linux/serdev.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+
+#define HDQ_CMD_READ			(0 << 7)
+#define HDQ_CMD_WRITE			(1 << 7)
+#define HDQ_CMD_REG_MASK		0x7f
+
+#define HDQ_UART_BAUD			57600
+#define HDQ_BREAK_US_MIN		250
+#define HDQ_BREAK_US_MAX		500
+#define HDQ_RECOVERY_US_MIN		150
+#define HDQ_RECOVERY_US_MAX		500
+#define HDQ_XFER_TIMEOUT_MS		500
+#define HDQ_WORD_READ_RETRIES		3
+
+#define HDQ_UART_ONE			0xfe
+#define HDQ_UART_ZERO			0xc0
+#define HDQ_UART_ONE_MIN		0xf0
+#define HDQ_UART_BYTE_LEN		8
+
+#define BQ27XXX_REG_CONTROL		0x00
+#define BQ27XXX_SUBCMD_DEVICE_TYPE	0x0001
+
+struct hdq_uart {
+	struct serdev_device *serdev;
+	struct bq27xxx_device_info di;
+
+	struct mutex xfer_lock;	/* serializes whole HDQ transactions */
+
+	/* Filled in by the (possibly IRQ-context) receive_buf callback;
+	 * protected by rx_lock, not the sleeping xfer_lock above.
+	 */
+	spinlock_t rx_lock;
+	struct completion rx_done;
+	u8 rx_start[HDQ_UART_BYTE_LEN];
+	u8 *rx_buf;
+	int rx_want;
+	int rx_count;
+};
+
+static void hdq_encode_byte(u8 byte, u8 *out)
+{
+	int i;
+
+	for (i = 0; i < HDQ_UART_BYTE_LEN; i++)
+		out[i] = (byte & (1 << i)) ? HDQ_UART_ONE : HDQ_UART_ZERO;
+}
+
+static int hdq_decode_byte(const u8 *in, u8 *byte)
+{
+	u8 val = 0;
+	int i;
+
+	/* Preserve the working reference's threshold decoder. UART sampling
+	 * can yield non-canonical low symbols (for example0xc3); do not
+	 * invent a stricter pulse-shape requirement for the kernel frontend.
+	 */
+	for (i = 0; i < HDQ_UART_BYTE_LEN; i++)
+		if (in[i] >= HDQ_UART_ONE_MIN)
+			val |= (1 << i);
+	*byte = val;
+	return 0;
+}
+
+static size_t hdq_uart_receive_buf(struct serdev_device *serdev,
+				   const u8 *data, size_t count)
+{
+	struct hdq_uart *hdq = serdev_device_get_drvdata(serdev);
+	unsigned long flags;
+	size_t consumed = 0;
+
+	spin_lock_irqsave(&hdq->rx_lock, flags);
+	while (consumed < count) {
+		if (!hdq->rx_want) {
+			consumed = count;
+			break;
+		}
+
+		if (hdq->rx_count < hdq->rx_want)
+			hdq->rx_buf[hdq->rx_count++] = data[consumed];
+		consumed++;
+
+		/* Require a contiguous command echo, across callback boundaries.
+		 * A mismatching byte must not leave an old partial prefix valid.
+		 * Retain a seven-byte sliding window until the real echo arrives.
+		 */
+		if (hdq->rx_count == HDQ_UART_BYTE_LEN &&
+		    memcmp(hdq->rx_buf, hdq->rx_start, HDQ_UART_BYTE_LEN)) {
+			memmove(hdq->rx_buf, hdq->rx_buf + 1, HDQ_UART_BYTE_LEN - 1);
+			hdq->rx_count--;
+		}
+
+		if (hdq->rx_count >= hdq->rx_want)
+			complete(&hdq->rx_done);
+	}
+	spin_unlock_irqrestore(&hdq->rx_lock, flags);
+
+	return consumed;
+}
+
+static const struct serdev_device_ops hdq_uart_serdev_ops = {
+	.receive_buf = hdq_uart_receive_buf,
+	.write_wakeup = serdev_device_write_wakeup,
+};
+
+static void hdq_arm_receive(struct hdq_uart *hdq, u8 *buf, int n,
+			    const u8 *start)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hdq->rx_lock, flags);
+	memcpy(hdq->rx_start, start, HDQ_UART_BYTE_LEN);
+	hdq->rx_buf = buf;
+	hdq->rx_count = 0;
+	hdq->rx_want = n;
+	reinit_completion(&hdq->rx_done);
+	spin_unlock_irqrestore(&hdq->rx_lock, flags);
+}
+
+static void hdq_disarm_receive(struct hdq_uart *hdq)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hdq->rx_lock, flags);
+	hdq->rx_buf = NULL;
+	hdq->rx_want = 0;
+	spin_unlock_irqrestore(&hdq->rx_lock, flags);
+}
+
+/* The receiver is armed before transmit so an immediate loopback echo or
+ * gauge response cannot race ahead of the waiter. Echo and response use one
+ * buffer and one completion because the tty layer may deliver both together.
+ */
+static int hdq_wait_receive(struct hdq_uart *hdq)
+{
+	long ret;
+
+	ret = wait_for_completion_timeout(&hdq->rx_done,
+					  msecs_to_jiffies(HDQ_XFER_TIMEOUT_MS));
+	hdq_disarm_receive(hdq);
+
+	return ret ? 0 : -ETIMEDOUT;
+}
+
+/* Asserts an HDQ break with the microsecond timing TI's spec requires,
+ * followed by the recovery gap -- both far shorter than break_ctl()'s
+ * own jiffies-granularity timing, so this drives it manually instead of
+ * trusting a fixed-duration break request.
+ */
+static int hdq_send_break(struct hdq_uart *hdq)
+{
+	int ret;
+
+	ret = serdev_device_break_ctl(hdq->serdev, -1);
+	if (ret)
+		return ret;
+	usleep_range(HDQ_BREAK_US_MIN, HDQ_BREAK_US_MAX);
+	ret = serdev_device_break_ctl(hdq->serdev, 0);
+	if (ret)
+		return ret;
+	usleep_range(HDQ_RECOVERY_US_MIN, HDQ_RECOVERY_US_MAX);
+
+	return 0;
+}
+
+/* One full HDQ byte transaction: break, send `n_tx` encoded UART bytes
+ * (the command byte alone for a read, command+data for a write),
+ * discard the single-wire echo of what we just sent, then -- for a
+ * read only -- collect the gauge's own encoded response byte.
+ */
+static int hdq_transact(struct hdq_uart *hdq, const u8 *tx, int n_tx,
+			u8 *resp)
+{
+	u8 rx[3 * HDQ_UART_BYTE_LEN];
+	ssize_t written;
+	int ret, rx_want = n_tx + (resp ? HDQ_UART_BYTE_LEN : 0);
+
+	if (rx_want > ARRAY_SIZE(rx))
+		return -EINVAL;
+
+	ret = hdq_send_break(hdq);
+	if (ret)
+		return ret;
+
+	hdq_arm_receive(hdq, rx, rx_want, tx);
+	written = serdev_device_write(hdq->serdev, tx, n_tx,
+				      msecs_to_jiffies(HDQ_XFER_TIMEOUT_MS));
+	if (written != n_tx) {
+		hdq_disarm_receive(hdq);
+		return written < 0 ? (int)written : -EIO;
+	}
+
+	serdev_device_wait_until_sent(hdq->serdev,
+				      msecs_to_jiffies(HDQ_XFER_TIMEOUT_MS));
+	ret = hdq_wait_receive(hdq);
+	if (ret) {
+		unsigned long flags;
+		int got;
+
+		/* Before a complete command echo, this is the pending sliding
+		 * window. Once the echo matches it includes echo+response.
+		 */
+		spin_lock_irqsave(&hdq->rx_lock, flags);
+		got = hdq->rx_count;
+		spin_unlock_irqrestore(&hdq->rx_lock, flags);
+
+		dev_info(&hdq->serdev->dev,
+			 "HDQ transact timeout: buffered %d/%d bytes: %*ph\n",
+			 got, rx_want, got, rx);
+		return ret;
+	}
+	if (memcmp(tx, rx, n_tx) != 0)
+		return -EIO;
+
+	if (resp)
+		memcpy(resp, rx + n_tx, HDQ_UART_BYTE_LEN);
+
+	return 0;
+}
+
+static int hdq_read_byte(struct hdq_uart *hdq, u8 reg, u8 *val)
+{
+	u8 cmd = HDQ_CMD_READ | (reg & HDQ_CMD_REG_MASK);
+	u8 tx[HDQ_UART_BYTE_LEN], resp[HDQ_UART_BYTE_LEN];
+	int ret;
+
+	hdq_encode_byte(cmd, tx);
+
+	mutex_lock(&hdq->xfer_lock);
+	ret = hdq_transact(hdq, tx, sizeof(tx), resp);
+	mutex_unlock(&hdq->xfer_lock);
+	if (ret)
+		return ret;
+
+	return hdq_decode_byte(resp, val);
+}
+
+static int hdq_write_byte(struct hdq_uart *hdq, u8 reg, u8 val)
+{
+	u8 cmd = HDQ_CMD_WRITE | (reg & HDQ_CMD_REG_MASK);
+	u8 tx[2 * HDQ_UART_BYTE_LEN];
+	int ret;
+
+	/* Sealed-safe volatile DEVICE_TYPE0001 only: no arbitrary writes. */
+	if (!((reg == 0x00 && val == 0x01) ||
+	      (reg == 0x01 && val == 0x00)))
+		return -EACCES;
+	hdq_encode_byte(cmd, tx);
+	hdq_encode_byte(val, tx + HDQ_UART_BYTE_LEN);
+
+	mutex_lock(&hdq->xfer_lock);
+	ret = hdq_transact(hdq, tx, sizeof(tx), NULL);
+	mutex_unlock(&hdq->xfer_lock);
+
+	return ret;
+}
+
+static int hdq_uart_read(struct bq27xxx_device_info *di, u8 reg, bool single)
+{
+	struct hdq_uart *hdq = container_of(di, struct hdq_uart, di);
+	unsigned int timeout = HDQ_WORD_READ_RETRIES;
+	u8 lower, upper, prev_upper;
+	int ret;
+
+	if (single) {
+		ret = hdq_read_byte(hdq, reg, &lower);
+		return ret ? ret : lower;
+	}
+
+	/* Stable 16-bit read: high/low/high, retrying if the high byte
+	 * changed between the two reads (the gauge's counters can tick
+	 * mid-transaction).
+	 */
+	ret = hdq_read_byte(hdq, reg + 1, &upper);
+	if (ret)
+		return ret;
+
+	do {
+		prev_upper = upper;
+
+		ret = hdq_read_byte(hdq, reg, &lower);
+		if (ret)
+			return ret;
+
+		ret = hdq_read_byte(hdq, reg + 1, &upper);
+		if (ret)
+			return ret;
+	} while (prev_upper != upper && --timeout);
+
+	if (timeout == 0)
+		return -EIO;
+
+	return (upper << 8) | lower;
+}
+
+static int hdq_uart_write(struct bq27xxx_device_info *di, u8 reg, int value,
+			  bool single)
+{
+	struct hdq_uart *hdq = container_of(di, struct hdq_uart, di);
+	int ret;
+
+	ret = hdq_write_byte(hdq, reg, value & 0xff);
+	if (ret || single)
+		return ret;
+
+	return hdq_write_byte(hdq, reg + 1, (value >> 8) & 0xff);
+}
+
+/* TI's sealed-access-safe Control() DEVICE_TYPE subcommand: write 0x0001
+ * to Control() (register 0x00/0x01), then read the same register pair
+ * back for the chip's numeric device type. Documented values include
+ * 0x0541 (BQ27541 family) and 0x0545 (BQ27545 family); the ADT's
+ * "bq27540" compatible string is a family hint, not a specific chip
+ * revision, so the real behavior is decided by this readback, not the
+ * string. An unrecognized value fails probe rather than guessing a
+ * register layout that may not match.
+ */
+static int hdq_uart_identify(struct hdq_uart *hdq, struct device *dev)
+{
+	u16 device_type;
+	int ret;
+
+	ret = hdq_uart_write(&hdq->di, BQ27XXX_REG_CONTROL,
+			     BQ27XXX_SUBCMD_DEVICE_TYPE, false);
+	if (ret)
+		return ret;
+
+	ret = hdq_uart_read(&hdq->di, BQ27XXX_REG_CONTROL, false);
+	if (ret < 0)
+		return ret;
+
+	device_type = ret & 0xffff;
+	dev_info(dev, "HDQ DEVICE_TYPE = 0x%04x\n", device_type);
+
+	if (device_type != 0x0545) {
+		dev_err(dev, "J72 expected verified DEVICE_TYPE0545, got %04x\n", device_type);
+		return -ENODEV;
+	}
+	hdq->di.chip = BQ27545;
+	hdq->di.name = "j72-bq27545-battery";
+
+	return 0;
+}
+
+static int hdq_uart_probe(struct serdev_device *serdev)
+{
+	struct device *dev = &serdev->dev;
+	struct hdq_uart *hdq;
+	int ret;
+
+	if (!of_machine_is_compatible("apple,j72"))
+		return -ENODEV;
+
+	hdq = devm_kzalloc(dev, sizeof(*hdq), GFP_KERNEL);
+	if (!hdq)
+		return -ENOMEM;
+
+	hdq->serdev = serdev;
+	mutex_init(&hdq->xfer_lock);
+	spin_lock_init(&hdq->rx_lock);
+	init_completion(&hdq->rx_done);
+
+	serdev_device_set_drvdata(serdev, hdq);
+	serdev_device_set_client_ops(serdev, &hdq_uart_serdev_ops);
+
+	ret = devm_serdev_device_open(dev, serdev);
+	if (ret)
+		return ret;
+
+	if (serdev_device_set_baudrate(serdev, HDQ_UART_BAUD) != HDQ_UART_BAUD)
+		return dev_err_probe(dev, -ERANGE, "failed to select 57600 baud\n");
+	serdev_device_set_flow_control(serdev, false);
+	ret = serdev_device_set_parity(serdev, SERDEV_PARITY_NONE);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to select no parity\n");
+
+	/* BAT-1: the reason this driver needs the new serdev stop-bit
+	 * helper at all -- TI's HDQ timing only fits inside 8N2 framing on
+	 * this UART's real bit rate (see research/j81-battery-hdq.md's
+	 * timing table); 8N1 leaves too short a cycle.
+	 */
+	ret = serdev_device_set_stopbits(serdev, SERDEV_STOPBITS_2);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to select two stop bits\n");
+
+	hdq->di.dev = dev;
+	hdq->di.bus.read = hdq_uart_read;
+	hdq->di.bus.write = hdq_uart_write;
+	/* The current core supports asynchronous cached telemetry. UI/UPower
+	 * queries must not start HDQ transactions on their calling thread. */
+	hdq->di.cache_only = true;
+	hdq->di.cache_refresh_ms = 3000;
+
+
+	ret = hdq_uart_identify(hdq, dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "HDQ device identification failed\n");
+
+	return bq27xxx_battery_setup(&hdq->di);
+}
+
+static void hdq_uart_remove(struct serdev_device *serdev)
+{
+	struct hdq_uart *hdq = serdev_device_get_drvdata(serdev);
+
+	bq27xxx_battery_teardown(&hdq->di);
+}
+
+static const struct of_device_id hdq_uart_of_match[] = {
+	/* Provisional development compatible tied to this board's ADT
+	 * evidence (docs/plans/2026-09-08-j81-bluetooth-battery-adt.md) --
+	 * to be finalized against the real DEVICE_TYPE readback logged
+	 * above before this driver is considered upstreamable.
+	 */
+	{ .compatible = "ti,bq27540-hdq-uart" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hdq_uart_of_match);
+
+static struct serdev_device_driver hdq_uart_driver = {
+	.probe = hdq_uart_probe,
+	.remove = hdq_uart_remove,
+	.driver = {
+		.name = "bq27xxx-hdq-uart",
+		.of_match_table = hdq_uart_of_match,
+	},
+};
+module_serdev_device_driver(hdq_uart_driver);
+
+MODULE_DESCRIPTION("TI HDQ battery gauge over UART (single-wire, bit-banged via serdev)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/j72-limit-core.h b/drivers/power/supply/j72-limit-core.h
new file mode 100644
index 000000000..cee30b5f2
--- /dev/null
+++ b/drivers/power/supply/j72-limit-core.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef J72_LIMIT_CORE_H
+#define J72_LIMIT_CORE_H
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/errno.h>
+#else
+#include <stdbool.h>
+#include <stdint.h>
+#include <errno.h>
+typedef uint64_t u64;
+#endif
+
+#define J72_HANDOFF 0x02u
+#define J72_TRIAL 0x4eu
+#define J72_TRIAL_MS 3600000u
+#define J72_LEASE_MS 2500u
+
+static inline bool j72_source_lease_valid(u64 now, u64 expires)
+{
+	return expires > now && expires - now <= J72_LEASE_MS;
+}
+
+struct j72_limit_io {
+	void *ctx;
+	int (*read)(void *ctx, unsigned int *value);
+	int (*write)(void *ctx, unsigned int value);
+};
+
+struct j72_limit_state {
+	bool used, touched, active, restored, restore_failed;
+	u64 deadline_ms;
+	int error;
+};
+
+/* Exclude the first five seconds regardless of session duration. */
+static inline bool j72_limit_sample_ready(const struct j72_limit_state *s,
+                                          u64 now)
+{
+	return s->active && now < s->deadline_ms &&
+	       s->deadline_ms - now <= J72_TRIAL_MS - 5000u;
+}
+
+/* Caller serializes state. Even a failed write may have reached hardware. */
+static int j72_limit_restore(struct j72_limit_state *s,
+			     const struct j72_limit_io *io)
+{
+	unsigned int value, attempt;
+	int ret = 0;
+
+	s->active = false;
+	if (!s->touched)
+		return 0;
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = io->write(io->ctx, J72_HANDOFF);
+		if (!ret) {
+			ret = io->read(io->ctx, &value);
+			if (!ret && value == J72_HANDOFF) {
+				s->touched = false;
+				s->restored = true;
+				return 0;
+			}
+			ret = ret ? ret : -EIO;
+		}
+	}
+	s->restore_failed = true;
+	s->error = ret;
+	return ret;
+}
+
+static int j72_limit_start(struct j72_limit_state *s,
+			   const struct j72_limit_io *io, u64 now,
+			   int guard_result)
+{
+	unsigned int value;
+	int ret;
+
+	if (s->used || s->active || s->restore_failed)
+		return -EPERM;
+	s->used = true;
+	if (guard_result) {
+		s->error = guard_result;
+		return guard_result;
+	}
+	ret = io->read(io->ctx, &value);
+	if (ret || value != J72_HANDOFF) {
+		s->error = ret ? ret : -EPERM;
+		return s->error;
+	}
+	s->deadline_ms = now + J72_TRIAL_MS;
+	s->touched = true;
+	s->active = true;
+	ret = io->write(io->ctx, J72_TRIAL);
+	if (!ret) {
+		ret = io->read(io->ctx, &value);
+		if (!ret && value != J72_TRIAL)
+			ret = -EIO;
+	}
+	if (ret) {
+		s->error = ret;
+		j72_limit_restore(s, io);
+	}
+	return ret;
+}
+
+static int j72_limit_check(struct j72_limit_state *s,
+			   const struct j72_limit_io *io, u64 now,
+			   int guard_result)
+{
+	unsigned int value;
+	int ret;
+
+	if (!s->active)
+		return 0;
+	if (now >= s->deadline_ms)
+		return j72_limit_restore(s, io);
+	if (guard_result) {
+		s->error = guard_result;
+		return j72_limit_restore(s, io);
+	}
+	ret = io->read(io->ctx, &value);
+	if (ret || value != J72_TRIAL) {
+		s->error = ret ? ret : -EPERM;
+		return j72_limit_restore(s, io);
+	}
+	return 0;
+}
+
+/* Bits: 1 presence, 2 SOC, 4 temperature, 8 voltage, 16 current. */
+static unsigned int j72_limit_pack_faults(int present, int soc, int temp,
+                                        int voltage, int pack_current)
+{
+ unsigned int faults = 0;
+ if (present != 1) faults |= 1;
+ if (soc < 10 || soc > 95) faults |= 2;
+ if (temp < 200 || temp > 380) faults |= 4;
+ if (voltage < 3500000 || voltage > 4200000) faults |= 8;
+ if (pack_current < -1500000 || pack_current > 1500000) faults |= 16;
+ return faults;
+}
+
+static int j72_limit_pack_guard(int present, int soc, int temp,
+                               int voltage, int pack_current)
+{
+ return j72_limit_pack_faults(present, soc, temp, voltage, pack_current) ? -ERANGE : 0;
+}
+#endif
diff --git a/drivers/power/supply/j72-maintain-core.h b/drivers/power/supply/j72-maintain-core.h
new file mode 100644
index 000000000..ab874a724
--- /dev/null
+++ b/drivers/power/supply/j72-maintain-core.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef J72_MAINTAIN_CORE_H
+#define J72_MAINTAIN_CORE_H
+#include "j72-limit-core.h"
+
+/* Existing on-current and battery cutoffs remain unchanged. The controller
+ * can wait without a current override, then start a new bounded window only
+ * after verified restoration, a fresh gauge vector and source qualification.
+ */
+#define J72_GAUGE_MAX_AGE_MS 6000u
+#define J72_RESUME_DELAY_MS 30000u
+#define J72_RESUME_SOC 90
+#define J72_RESUME_VOLTAGE_UV 4100000
+#define J72_RESUME_TEMP_TENTHC 365
+
+enum j72_maintain_mode {
+ J72_OFF, J72_RUNNING, J72_WAIT_FULL, J72_WAIT_COOL,
+ J72_WAIT_WINDOW, J72_WAIT_START, J72_FAULT
+};
+struct j72_maintain {
+ bool enabled, fault, sample_valid;
+ enum j72_maintain_mode mode;
+ int sample[5], sample_error, error;
+ u64 sample_at_ms, stopped_at_ms;
+ unsigned int cycles, pauses;
+ unsigned int last_pause, warm_full_resumes;
+ bool thermal_latched;
+};
+
+static int j72_maintain_pause(struct j72_maintain *m,
+ struct j72_limit_state *p, const struct j72_limit_io *io,
+ u64 now, enum j72_maintain_mode mode, int error, bool fatal)
+{
+ bool was_active = p->active;
+ if (m->fault) {fatal=true;if (!error) error=m->error;}
+ int ret = j72_limit_restore(p, io);
+ if (was_active || mode==J72_OFF || fatal) m->last_pause=mode;
+ if (was_active) {m->pauses++; m->stopped_at_ms=now;}
+ if (ret || p->restore_failed) {fatal=true;error=ret ? ret : -EIO;}
+ m->mode=fatal ? J72_FAULT : mode;
+ m->fault=fatal; m->error=error;
+ if (fatal) m->enabled=false;
+ return ret ? ret : error;
+}
+
+/* Root explicitly requalifies after a stopped fault. This never enables
+ * charging, and a failed/unverified restoration can never be reset here. */
+static int j72_maintain_requalify(struct j72_maintain *m,
+ struct j72_limit_state *p, const struct j72_limit_io *io,
+ u64 now, int source_error, int pmic_error)
+{
+ unsigned int value;
+ int ret;
+ if (!m->fault || m->enabled || p->active || p->touched || p->restore_failed ||
+     (p->used && !p->restored)) return -EPERM;
+ if (source_error || pmic_error) return source_error ? source_error : pmic_error;
+ if (!m->sample_valid || m->sample_error || now<m->sample_at_ms ||
+     now-m->sample_at_ms>=J72_GAUGE_MAX_AGE_MS) return -ETIMEDOUT;
+ if (m->sample[0]!=1 || m->sample[1]<10 || m->sample[1]>100 ||
+     m->sample[2]<200 || m->sample[2]>500 || m->sample[3]<3500000 ||
+     m->sample[3]>4400000 || m->sample[4]<-1500000 || m->sample[4]>1500000)
+  return -ERANGE;
+ ret=io->read(io->ctx,&value);
+ if (ret || value!=J72_HANDOFF) return ret ? ret : -EPERM;
+ m->fault=false;m->error=0;m->mode=J72_OFF;p->error=0;
+ return 0;
+}
+
+static int j72_maintain_step(struct j72_maintain *m,
+ struct j72_limit_state *p, const struct j72_limit_io *io,
+ u64 now, int source_error, int pmic_error)
+{
+ unsigned int faults, value;
+ int ret;
+ if (!m->enabled || m->fault) return 0;
+ if (source_error || pmic_error)
+  return j72_maintain_pause(m,p,io,now,J72_FAULT,
+                            source_error ? source_error : pmic_error,true);
+ if (!m->sample_valid || m->sample_error || now < m->sample_at_ms ||
+     now-m->sample_at_ms >= J72_GAUGE_MAX_AGE_MS)
+  return j72_maintain_pause(m,p,io,now,J72_FAULT,
+                            m->sample_error ? m->sample_error : -ETIMEDOUT,true);
+ faults=j72_limit_pack_faults(m->sample[0],m->sample[1],m->sample[2],m->sample[3],m->sample[4]);
+ /* High SOC/voltage/temperature are holds, never permission to charge beyond
+  * the old cutoffs. Missing/low/invalid data and excessive current latch off. */
+ if ((faults & (1u|16u)) || m->sample[1]<10 || m->sample[1]>100 ||
+     m->sample[2]<200 || m->sample[2]>500 ||
+     m->sample[3]<3500000 || m->sample[3]>4400000)
+  return j72_maintain_pause(m,p,io,now,J72_FAULT,-ERANGE,true);
+ if (m->sample[2]>380) {
+  m->thermal_latched=true;
+  return j72_maintain_pause(m,p,io,now,J72_WAIT_COOL,0,false);
+ }
+ if (m->sample[1]>95 || m->sample[3]>4200000)
+  return j72_maintain_pause(m,p,io,now,J72_WAIT_FULL,0,false);
+ if (p->active) {
+  ret=j72_limit_check(p,io,now,0);
+  if (ret || p->error || p->restore_failed)
+   return j72_maintain_pause(m,p,io,now,J72_FAULT,ret ? ret : p->error,true);
+  if (!p->active) {
+   m->pauses++;m->stopped_at_ms=now;m->last_pause=J72_WAIT_WINDOW;
+   return j72_maintain_pause(m,p,io,now,J72_WAIT_WINDOW,0,false);
+  }
+  m->mode=J72_RUNNING;return 0;
+ }
+ /* An expired window's successful restore is necessary but not a new start
+  * permission. Require cooldown plus the same conservative restart thresholds. */
+ if (m->mode==J72_WAIT_WINDOW && !m->stopped_at_ms) m->stopped_at_ms=now;
+ ret=io->read(io->ctx,&value);
+ if (ret || value!=J72_HANDOFF || p->touched || p->restore_failed ||
+     (p->used && !p->restored))
+  return j72_maintain_pause(m,p,io,now,J72_FAULT,ret ? ret : -EPERM,true);
+ if (m->sample[1]>J72_RESUME_SOC || m->sample[3]>J72_RESUME_VOLTAGE_UV) {
+  m->mode=J72_WAIT_FULL;return 0;
+ }
+ /* A voltage/SOC hold alone is not a thermal trip. The active
+  * 38 C cutoff was checked above. Keep 36.5 C for every initial
+  * start, expired window, stop/fault/requalification and any
+  * actual thermal trip, even if a later voltage hold masks it. */
+ if (m->sample[2]>J72_RESUME_TEMP_TENTHC &&
+     (!m->cycles || m->last_pause!=J72_WAIT_FULL || m->thermal_latched)) {
+  m->mode=J72_WAIT_COOL;return 0;
+ }
+ if (m->cycles && (now<m->stopped_at_ms ||
+     now-m->stopped_at_ms<J72_RESUME_DELAY_MS)) return 0;
+ /* Only this path clears the one-window state; all restoration checks above
+  * precede it. A latched hardware/read/source fault cannot reach this path. */
+ *p=(struct j72_limit_state){0};
+ ret=j72_limit_start(p,io,now,0);
+ if (ret || !p->active)
+  return j72_maintain_pause(m,p,io,now,J72_FAULT,ret ? ret : -EIO,true);
+ if (m->sample[2]>J72_RESUME_TEMP_TENTHC) m->warm_full_resumes++;
+ m->thermal_latched=false;
+ m->cycles++;m->mode=J72_RUNNING;return 0;
+}
+#endif
diff --git a/drivers/power/supply/j72_charge_maintain.c b/drivers/power/supply/j72_charge_maintain.c
new file mode 100644
index 000000000..2af7c2eb0
--- /dev/null
+++ b/drivers/power/supply/j72_charge_maintain.c
@@ -0,0 +1,544 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Opt-in qualified-hub maintenance with bounded 1050mA windows.
+ * Only PMIC register 04c0 is writable. No write on load or arm.
+ * The high-priority deadline never reads the gauge. Gauge reads occur
+ * outside policy_lock, on a separate queue, so HDQ waits cannot block it.
+ */
+#include <linux/device.h>
+#include <linux/i2c.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include "../../usb/dwc2/core.h"
+#include <linux/power/bq27xxx_battery.h>
+#include <linux/power_supply.h>
+#include <linux/reboot.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/suspend.h>
+#include <linux/utsname.h>
+#include <linux/workqueue.h>
+#include "j72-limit-core.h"
+#include "j72-maintain-core.h"
+
+#define EXPECTED_RELEASE "7.3.0-rc1-j72-pw1-orchard-apple-4k"
+#define PMIC_PATH "/soc/i2c@20a110000/pmic@3c"
+#define BATTERY_PATH "/soc/serial@20a0b4000/battery"
+
+static DEFINE_MUTEX(policy_lock);
+static struct j72_limit_state policy;
+static struct j72_maintain maintain;
+static int maintain_pmic_error;
+static struct device *pmic, *udc;
+static u64 source_lease_until;
+static struct regmap *map;
+static struct power_supply *battery;
+static struct workqueue_struct *deadline_queue, *guard_queue;
+static bool ready, armed, power_down;
+static struct input_handle *home_handle;
+static unsigned int samples;
+static int baseline_current, current_min, current_max;
+/* Stored under policy_lock after gauge I/O; frozen first failed reading. */
+static int guard_values[5], guard_failed_values[5];
+static unsigned int guard_faults, guard_failed_faults;
+static u64 guard_at_ms, guard_failed_at_ms;
+static unsigned int read_failures, fresh_refreshes, read_recoveries;
+static int last_read_errno, last_failed_prop;
+static u64 last_read_failure_ms;
+
+static void deadline_fn(struct work_struct *work);
+static void guard_fn(struct work_struct *work);
+static void request_fn(struct work_struct *work);
+static void abort_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(deadline_work, deadline_fn);
+static DECLARE_DELAYED_WORK(guard_work, guard_fn);
+static DECLARE_WORK(request_work, request_fn);
+static DECLARE_WORK(abort_work, abort_fn);
+
+static u64 now_ms(void)
+{
+	return ktime_to_ms(ktime_get_boottime());
+}
+
+/* Exact-kernel read-only gadget state, protected against driver removal.
+ * A configured gadget is necessary but does not identify a charging source.
+ * The host must also renew a lease after verifying the qualified hub port.
+ */
+static int source_guard(void)
+{
+ struct dwc2_hsotg *hsotg;
+ int ret = -ENOTCONN;
+ if (!j72_source_lease_valid(now_ms(), source_lease_until)) return -ETIME;
+ if (!udc || !device_trylock(udc)) return -EBUSY;
+ if (udc->driver && !strcmp(dev_driver_string(udc), "dwc2")) {
+  hsotg = dev_get_drvdata(udc);
+  if (hsotg && READ_ONCE(hsotg->gadget.state) == USB_STATE_CONFIGURED &&
+      READ_ONCE(hsotg->gadget.speed) == USB_SPEED_HIGH) ret = 0;
+ }
+ device_unlock(udc);
+ return ret;
+}
+
+static int lease_set(const char *value, const struct kernel_param *unused)
+{
+ int ret = 0;
+ if (!sysfs_streq(value, "qualified-JCH377-1500mA")) return -EINVAL;
+ mutex_lock(&policy_lock);
+ if (!ready || policy.restore_failed) ret = -EPERM;
+ else source_lease_until = now_ms() + J72_LEASE_MS;
+ mutex_unlock(&policy_lock);
+ return ret;
+}
+static const struct kernel_param_ops lease_ops = { .set = lease_set };
+module_param_cb(source_lease, &lease_ops, NULL, 0200);
+
+static int read_limit(void *unused, unsigned int *value)
+{
+	return regmap_read_bypassed(map, 0x04c0, value);
+}
+
+static int write_limit(void *unused, unsigned int value)
+{
+	u64 now, remaining;
+
+	if (value != J72_HANDOFF && value != J72_TRIAL)
+		return -EPERM;
+	if (value == J72_TRIAL) {
+		/* This callback is reached only after the core records ownership. */
+		now = now_ms();
+		remaining = policy.deadline_ms > now ? policy.deadline_ms - now : 0;
+		if (!remaining)
+			return -ETIME;
+		mod_delayed_work(deadline_queue, &deadline_work,
+				 msecs_to_jiffies(min_t(u64, 250, remaining)));
+	}
+	return regmap_write(map, 0x04c0, value);
+}
+
+static const struct j72_limit_io io = {
+	.read = read_limit,
+	.write = write_limit,
+};
+
+static int pmic_guard(void)
+{
+	static const unsigned int ceiling_regs[] = {0x04c6, 0x04c7, 0x04ce};
+	unsigned int value, i;
+	int ret;
+
+	ret = regmap_read_bypassed(map, 0x0010, &value);
+	if (ret || (value & BIT(2)))
+		return ret ? ret : -EPERM;
+	for (i = 0; i < ARRAY_SIZE(ceiling_regs); i++) {
+		ret = regmap_read_bypassed(map, ceiling_regs[i], &value);
+		if (ret || value != 0x3f)
+			return ret ? ret : -EPERM;
+	}
+	return 0;
+}
+
+/* A failed flags refresh is cached for five seconds by the core. Retry one
+ * complete vector after an explicit fresh core update, never a stale value.
+ * The separate source/deadline queue remains active during all gauge I/O.
+ */
+static int pack_values(int *values)
+{
+ static const enum power_supply_property props[] = {
+  POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_CAPACITY,
+  POWER_SUPPLY_PROP_TEMP, POWER_SUPPLY_PROP_VOLTAGE_NOW,
+  POWER_SUPPLY_PROP_CURRENT_NOW,
+ };
+ union power_supply_propval v;
+ unsigned int attempt, i;
+ int ret = -EIO;
+ struct bq27xxx_device_info *di = power_supply_get_drvdata(battery);
+ /* A cached property can be readable even if its worker stopped. Do not
+  * turn that old vector into a new charge-policy timestamp. Never wait
+  * for the gauge lock here; the independent deadline keeps restoring. */
+ if (!di || !mutex_trylock(&di->lock)) return -EBUSY;
+ if (di->cache_only && (!di->last_update ||
+     time_after_eq(jiffies, di->last_update +
+                   msecs_to_jiffies(J72_GAUGE_MAX_AGE_MS)))) ret = -ETIMEDOUT;
+ else ret = 0;
+ mutex_unlock(&di->lock);
+ if (ret) return ret;
+ for (attempt = 0; attempt < 2; attempt++) {
+  for (i = 0; i < ARRAY_SIZE(props); i++) {
+   ret = power_supply_get_property(battery, props[i], &v);
+   if (ret) break;
+   values[i] = v.intval;
+  }
+  if (!ret) {
+   if (attempt) {
+    mutex_lock(&policy_lock); read_recoveries++; mutex_unlock(&policy_lock);
+   }
+   return 0;
+  }
+  mutex_lock(&policy_lock);
+  read_failures++; last_read_errno = ret; last_failed_prop = props[i];
+  last_read_failure_ms = now_ms();
+  mutex_unlock(&policy_lock);
+  if (attempt || (ret != -ETIMEDOUT && ret != -EIO)) return ret;
+  mutex_lock(&policy_lock); fresh_refreshes++; mutex_unlock(&policy_lock);
+  bq27xxx_battery_update(power_supply_get_drvdata(battery));
+ }
+ return ret;
+}
+
+/* Never hold policy_lock around this function: a gauge access can wait. */
+
+
+static void finish_locked(void)
+{
+ armed = maintain.enabled;
+}
+
+static void deadline_fn(struct work_struct *work)
+{
+ mutex_lock(&policy_lock);
+ if (maintain.enabled) {
+  j72_maintain_step(&maintain,&policy,&io,now_ms(),source_guard(),maintain_pmic_error);
+  finish_locked();
+  if (maintain.enabled)
+   mod_delayed_work(deadline_queue,&deadline_work,msecs_to_jiffies(250));
+ }
+ mutex_unlock(&policy_lock);
+}
+
+static void guard_fn(struct work_struct *work)
+{
+ int values[5], ret, pmic_ret;
+ if (!READ_ONCE(ready) || !READ_ONCE(maintain.enabled)) return;
+ ret=pack_values(values); /* Never hold policy_lock during HDQ. */
+ pmic_ret=pmic_guard();
+ mutex_lock(&policy_lock);
+ if (maintain.enabled) {
+  maintain.sample_error=ret;maintain_pmic_error=pmic_ret;
+  if (!ret) {
+   memcpy(maintain.sample,values,sizeof(values));
+   memcpy(guard_values,values,sizeof(values));
+   maintain.sample_at_ms=guard_at_ms=now_ms();maintain.sample_valid=true;
+   guard_faults=j72_limit_pack_faults(values[0],values[1],values[2],values[3],values[4]);
+   if (policy.active && j72_limit_sample_ready(&policy,now_ms())) {
+    if (!samples || values[4]<current_min) current_min=values[4];
+    if (!samples || values[4]>current_max) current_max=values[4];
+    samples++;
+   }
+  }
+  j72_maintain_step(&maintain,&policy,&io,now_ms(),source_guard(),maintain_pmic_error);
+  finish_locked();
+  if (maintain.enabled) queue_delayed_work(guard_queue,&guard_work,2*HZ);
+ }
+ mutex_unlock(&policy_lock);
+}
+
+static void request_fn(struct work_struct *work)
+{
+ int values[5],ret,pmic_ret;
+ if (!READ_ONCE(ready) || !READ_ONCE(armed) || READ_ONCE(power_down)) return;
+ ret=pack_values(values);pmic_ret=pmic_guard();
+ mutex_lock(&policy_lock);
+ if (!ready || !armed || power_down || maintain.enabled || maintain.fault) goto done;
+ maintain.sample_error=ret;maintain_pmic_error=pmic_ret;
+ if (!ret) {
+  memcpy(maintain.sample,values,sizeof(values));
+  memcpy(guard_values,values,sizeof(values));
+  maintain.sample_valid=true;maintain.sample_at_ms=guard_at_ms=now_ms();
+  baseline_current=values[4];
+ }
+ maintain.enabled=true;maintain.mode=J72_WAIT_START;
+ j72_maintain_step(&maintain,&policy,&io,now_ms(),source_guard(),maintain_pmic_error);
+ finish_locked();
+ if (maintain.enabled) {
+  mod_delayed_work(deadline_queue,&deadline_work,msecs_to_jiffies(250));
+  queue_delayed_work(guard_queue,&guard_work,2*HZ);
+ }
+done:
+ mutex_unlock(&policy_lock);
+}
+
+static void abort_fn(struct work_struct *work)
+{
+ mutex_lock(&policy_lock);
+ armed=false;maintain.enabled=false;
+ j72_maintain_pause(&maintain,&policy,&io,now_ms(),J72_OFF,0,false);
+ mutex_unlock(&policy_lock);
+}
+
+static void home_event(struct input_handle *handle, unsigned int type,
+                       unsigned int code, int value)
+{
+ if (type!=EV_KEY || !READ_ONCE(ready) || code!=KEY_POWER) return;
+ WRITE_ONCE(power_down,value!=0);
+ if (value==1) {
+  WRITE_ONCE(armed,false);
+  queue_work(deadline_queue,&abort_work);
+ }
+ /* Home remains available to the desktop and cannot start charging. */
+}
+
+static int home_connect(struct input_handler *handler, struct input_dev *dev,
+			const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int ret;
+
+	if (!dev->name || strcmp(dev->name, "gpio-keys") ||
+	    !test_bit(KEY_HOMEPAGE, dev->keybit)) return -ENODEV;
+	if (home_handle) return -EBUSY;
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle) return -ENOMEM;
+	handle->dev = dev; handle->handler = handler; handle->name = "j72-input-trial";
+	ret = input_register_handle(handle);
+	if (ret) goto free;
+	ret = input_open_device(handle);
+	if (ret) { input_unregister_handle(handle); goto free; }
+	home_handle = handle;
+	return 0;
+free:
+	kfree(handle);
+	return ret;
+}
+
+static void home_disconnect(struct input_handle *handle)
+{
+	WRITE_ONCE(armed, false);
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	home_handle = NULL;
+	if (READ_ONCE(ready)) queue_work(deadline_queue, &abort_work);
+	kfree(handle);
+}
+
+static const struct input_device_id home_ids[] = {
+	{ .flags = INPUT_DEVICE_ID_MATCH_EVBIT, .evbit = { BIT_MASK(EV_KEY) } },
+	{ },
+};
+static struct input_handler home_handler = {
+	.event = home_event, .connect = home_connect, .disconnect = home_disconnect,
+	.name = "j72-charge-maintain34", .id_table = home_ids,
+};
+
+static int arm_set(const char *value, const struct kernel_param *unused)
+{
+ unsigned int limit;
+ int ret=0;
+ bool on;
+ if (sysfs_streq(value,"maintain-qualified-JCH377")) on=true;
+ else if (sysfs_streq(value,"stop")) on=false;
+ else return -EINVAL;
+ mutex_lock(&policy_lock);
+ armed=false;
+ if (!on) {
+  maintain.enabled=false;
+  j72_maintain_pause(&maintain,&policy,&io,now_ms(),J72_OFF,0,maintain.fault);
+  ret=policy.restore_failed ? -EIO : 0;
+ } else if (!ready || maintain.enabled || maintain.fault || policy.restore_failed || power_down) ret=-EPERM;
+ else {
+  ret=source_guard();
+  if (!ret) ret=pmic_guard();
+  if (!ret) ret=read_limit(NULL,&limit);
+  if (!ret && limit!=J72_HANDOFF) ret=-EPERM;
+  if (!ret) armed=true;
+ }
+ mutex_unlock(&policy_lock);
+ return ret;
+}
+static const struct kernel_param_ops arm_ops = { .set = arm_set };
+module_param_cb(arm_hub, &arm_ops, NULL, 0200);
+
+/* Explicit enable after host source qualification. Home never arms/starts it. */
+static int begin_set(const char *value, const struct kernel_param *unused)
+{
+ int ret=0;
+ if (!sysfs_streq(value,"begin-qualified-maintenance")) return -EINVAL;
+ mutex_lock(&policy_lock);
+ if (!ready || !armed || maintain.enabled || maintain.fault || power_down || policy.restore_failed) ret=-EPERM;
+ else schedule_work(&request_work);
+ mutex_unlock(&policy_lock);
+ return ret;
+}
+static const struct kernel_param_ops begin_ops = { .set = begin_set };
+module_param_cb(begin_session, &begin_ops, NULL, 0200);
+
+/* Only an explicit root request after fresh host qualification may clear
+ * a stopped fault. Renewing source_lease alone never enables or clears it. */
+static int requalify_set(const char *value, const struct kernel_param *unused)
+{
+ int values[5], ret, pmic_ret;
+ if (!sysfs_streq(value,"requalify-verified-restoration")) return -EINVAL;
+ if (!READ_ONCE(ready)) return -ENODEV;
+ ret=pack_values(values);pmic_ret=pmic_guard();
+ mutex_lock(&policy_lock);
+ maintain.sample_error=ret;
+ if (!ret) {
+  memcpy(maintain.sample,values,sizeof(values));
+  maintain.sample_valid=true;maintain.sample_at_ms=now_ms();
+ }
+ if (!ready || power_down) ret=-EPERM;
+ else ret=j72_maintain_requalify(&maintain,&policy,&io,now_ms(),source_guard(),pmic_ret);
+ mutex_unlock(&policy_lock);
+ return ret;
+}
+static const struct kernel_param_ops requalify_ops = { .set = requalify_set };
+module_param_cb(requalify_source, &requalify_ops, NULL, 0200);
+
+static int status_get(char *buf, const struct kernel_param *unused)
+{
+	u64 remaining, now;
+	int n;
+
+	mutex_lock(&policy_lock);
+	now = now_ms();
+	remaining = policy.active && policy.deadline_ms > now ? policy.deadline_ms - now : 0;
+	n = scnprintf(buf, PAGE_SIZE,
+		"ready=%u\narmed=%u\nused=%u\nactive=%u\nrestored=%u\nrestore_failed=%u\nerror=%d\nremaining_ms=%llu\nsource_lease_until_ms=%llu\nbaseline_current_uA=%d\ntrial_samples=%u\ntrial_current_min_uA=%d\ntrial_current_max_uA=%d\n",
+		ready, armed, policy.used, policy.active, policy.restored,
+		policy.restore_failed, policy.error, (unsigned long long)remaining,
+		(unsigned long long)source_lease_until, baseline_current, samples, current_min, current_max);
+	n += scnprintf(buf + n, PAGE_SIZE - n,
+		"guard_at_ms=%llu\nguard_faults=%u\nguard_present=%d\nguard_soc=%d\nguard_temp_tenthC=%d\nguard_voltage_uV=%d\nguard_current_uA=%d\n"
+		"failed_guard_at_ms=%llu\nfailed_guard_faults=%u\nfailed_guard_present=%d\nfailed_guard_soc=%d\nfailed_guard_temp_tenthC=%d\nfailed_guard_voltage_uV=%d\nfailed_guard_current_uA=%d\n",
+		(unsigned long long)guard_at_ms, guard_faults,
+		guard_values[0], guard_values[1], guard_values[2], guard_values[3], guard_values[4],
+		(unsigned long long)guard_failed_at_ms, guard_failed_faults,
+		guard_failed_values[0], guard_failed_values[1], guard_failed_values[2],
+		guard_failed_values[3], guard_failed_values[4]);
+ n += scnprintf(buf + n, PAGE_SIZE - n,
+  "read_failures=%u\nfresh_refreshes=%u\nread_recoveries=%u\nlast_read_errno=%d\nlast_failed_prop=%d\nlast_read_failure_ms=%llu\n",
+  read_failures, fresh_refreshes, read_recoveries, last_read_errno,
+  last_failed_prop, (unsigned long long)last_read_failure_ms);
+ n += scnprintf(buf+n,PAGE_SIZE-n,
+  "enabled=%u\nfault=%u\nmode=%u\ncycles=%u\npauses=%u\ncontroller_error=%d\nsample_at_ms=%llu\n",
+  maintain.enabled,maintain.fault,maintain.mode,maintain.cycles,maintain.pauses,
+  maintain.error,(unsigned long long)maintain.sample_at_ms);
+ n += scnprintf(buf+n,PAGE_SIZE-n,
+  "resume_policy=1\nlast_pause=%u\nthermal_latched=%u\nwarm_full_resumes=%u\n",
+  maintain.last_pause,maintain.thermal_latched,maintain.warm_full_resumes);
+ mutex_unlock(&policy_lock);
+ return n;
+}
+static const struct kernel_param_ops status_ops = { .get = status_get };
+module_param_cb(status, &status_ops, NULL, 0400);
+
+static int prepare_stop(void)
+{
+	int ret;
+	WRITE_ONCE(armed, false);
+	mutex_lock(&policy_lock);
+	maintain.enabled=false;
+	j72_maintain_pause(&maintain,&policy,&io,now_ms(),J72_OFF,0,maintain.fault);
+	ret=policy.restore_failed ? -EIO : 0;
+	mutex_unlock(&policy_lock);
+	return ret;
+}
+static int pm_event(struct notifier_block *nb, unsigned long event, void *unused)
+{
+	if (event == PM_SUSPEND_PREPARE || event == PM_HIBERNATION_PREPARE ||
+	    event == PM_RESTORE_PREPARE) return notifier_from_errno(prepare_stop());
+	return NOTIFY_DONE;
+}
+static int reboot_event(struct notifier_block *nb, unsigned long event, void *unused)
+{
+	prepare_stop();
+	return NOTIFY_DONE;
+}
+static struct notifier_block pm_nb = { .notifier_call = pm_event };
+static struct notifier_block reboot_nb = { .notifier_call = reboot_event };
+
+static int exact_pmic(struct device *dev, const void *node)
+{
+	struct i2c_client *c = i2c_verify_client(dev);
+	return c && c->addr == 0x3c && dev->of_node == node &&
+		of_device_is_compatible(dev->of_node, "apple,anya-pmic");
+}
+
+static int __init trial_init(void)
+{
+	struct device_node *node;
+	struct bq27xxx_device_info *di;
+	unsigned int limit;
+	int ret = -ENODEV;
+
+	if (!of_machine_is_compatible("apple,j72") ||
+	    strcmp(utsname()->release, EXPECTED_RELEASE)) return -ENODEV;
+	node = of_find_node_by_path("/soc/bus@20c000000/usbdev@20c100000");
+ if (!node) return -ENODEV;
+ udc = bus_find_device_by_of_node(&platform_bus_type, node);
+ of_node_put(node);
+ if (!udc) return -ENODEV;
+ node = of_find_node_by_path(PMIC_PATH);
+	if (!node) { put_device(udc); return -ENODEV; }
+	pmic = bus_find_device(&i2c_bus_type, NULL, node, exact_pmic);
+	of_node_put(node);
+	if (!pmic) { put_device(udc); return -ENODEV; }
+	map = dev_get_regmap(pmic, NULL);
+	if (!pmic->driver || !map || regmap_get_val_bytes(map) != 1) goto put_pmic;
+	battery = power_supply_get_by_name("j72-bq27545-battery");
+	if (!battery) goto put_pmic;
+	di = power_supply_get_drvdata(battery);
+	node = of_find_node_by_path(BATTERY_PATH);
+	if (!di || !node || di->dev->of_node != node || di->chip != BQ27545 ||
+	    strcmp(dev_driver_string(di->dev), "bq27xxx-hdq-uart")) {
+		of_node_put(node); goto put_battery;
+	}
+	of_node_put(node);
+	ret = pmic_guard();
+	if (!ret) ret = read_limit(NULL, &limit);
+	if (!ret && limit != J72_HANDOFF) ret = -EPERM;
+	if (ret) goto put_battery;
+	deadline_queue = alloc_workqueue("j72-limit-deadline", WQ_UNBOUND | WQ_HIGHPRI | WQ_MEM_RECLAIM, 1);
+	guard_queue = alloc_workqueue("j72-limit-gauge", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	if (!deadline_queue || !guard_queue) { ret = -ENOMEM; goto destroy; }
+	ret = register_pm_notifier(&pm_nb);
+	if (ret) goto destroy;
+	ret = register_reboot_notifier(&reboot_nb);
+	if (ret) goto unreg_pm;
+	ret = input_register_handler(&home_handler);
+	if (ret) goto unreg_reboot;
+	if (!home_handle) { ret = -ENODEV; goto unreg_input; }
+	WRITE_ONCE(ready, true);
+	pr_info("j72 input trial: ready, disabled; qualified-hub maintenance only; NO write at load\n");
+	return 0;
+unreg_input:
+	input_unregister_handler(&home_handler);
+unreg_reboot:
+	unregister_reboot_notifier(&reboot_nb);
+unreg_pm:
+	unregister_pm_notifier(&pm_nb);
+destroy:
+	if (deadline_queue) destroy_workqueue(deadline_queue);
+	if (guard_queue) destroy_workqueue(guard_queue);
+put_battery:
+	power_supply_put(battery);
+put_pmic:
+	put_device(pmic);
+	put_device(udc);
+	return ret;
+}
+
+static void __exit trial_exit(void)
+{
+	WRITE_ONCE(ready, false);
+	prepare_stop();
+	input_unregister_handler(&home_handler);
+	unregister_reboot_notifier(&reboot_nb);
+	unregister_pm_notifier(&pm_nb);
+	cancel_work_sync(&request_work);
+	cancel_work_sync(&abort_work);
+	cancel_delayed_work_sync(&guard_work);
+	cancel_delayed_work_sync(&deadline_work);
+	destroy_workqueue(guard_queue);
+	destroy_workqueue(deadline_queue);
+	power_supply_put(battery);
+	put_device(pmic);
+	put_device(udc);
+}
+module_init(trial_init);
+module_exit(trial_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Exact J72/#35 opt-in hub maintenance; unchanged limits, source lease and per-window rollback");
