+static void apple_asp_handle_cq(struct apple_asp *asp, u8 tag, u8 status)
+{
+	struct request *rq;
+	struct asp_iod *iod;
+
+	if (READ_ONCE(asp->failed) || tag>=ASP_NUM_TAGS || !asp->tagset.tags ||
+	    !asp->tagset.tags[0]) return;
+	rq = blk_mq_tag_to_rq(asp->tagset.tags[0], tag);
+	if (unlikely(!rq || !blk_mq_request_started(rq))) {
+		dev_warn(asp->dev, "invalid tag %d completed with status %d",
+			 tag, status);
+		return;
+	}
+
+	dma_rmb();
+
+	iod = blk_mq_rq_to_pdu(rq);
+	iod->status = status;
+
+	if (iod->buffer && iod->buf_len <= ASP_TAG_SIZE-ASP_CMD_HDR_SIZE) {
+		void *cmdd = asp_q_cmd_data(asp, &iod->cmd);
+		memcpy(iod->buffer, cmdd, iod->buf_len);
+	}
+
+	blk_mq_complete_request(rq);
+}
+
+static void apple_asp_rtkit_recv(void *cookie, u8 endpoint, u64 message)
+{
+	struct apple_asp *asp = cookie;
+
+	if (endpoint != asp->ep) {
+		dev_warn(asp->dev, "Message to unknown endpoint %d", endpoint);
+		return;
+	}
+
+	if (READ_ONCE(asp->failed)) {
+		/* Retain the request/DMA, but make any late acknowledgement visible.
+		 * Never treat it as recovery or permit another submission.
+		 */
+		dev_warn_ratelimited(asp->dev,
+			"ignored ASP message after failure: endpoint=0x%x message=0x%016llx\n",
+			endpoint, (unsigned long long)message);
+		return;
+	}
+	if (asp->init_ret < 0)
+		return;
+
+	u8 type = FIELD_GET(ASP_MSG_TYPE, message);
+
+	/* noise */
+	if (type == ASP_MSG_TYPE_UNK4)
+		return;
+
+	if (type != ASP_MSG_TYPE_COMPLETE) {
+		dev_warn(asp->dev, "Unhandled ASP message type %d", type);
+		return;
+	}
+
+	u8 tag = FIELD_GET(ASP_COMPLETION_TAG, message);
+	u8 status = FIELD_GET(ASP_COMPLETION_STATUS, message);
+
+	if (tag == ASP_COMPLETION_TAG_READY
+	    || tag == ASP_COMPLETION_TAG_CMDBUF_OK) {
+
+		if (status != ASP_COMPLETION_STATUS_INIT) {
+			dev_err(asp->dev,
+				"Unexpected init message status: %d", status);
+			asp->init_ret = -EIO;
+			return;
+		}
+
+		if (tag == ASP_COMPLETION_TAG_READY)
+			return apple_asp_setup_queue(asp);
+		else if (tag == ASP_COMPLETION_TAG_CMDBUF_OK)
+			return apple_asp_setup_tags(asp);
+	}
+
+
+	if (tag >= ASP_NUM_TAGS) {
+		dev_warn(asp->dev, "ASP tag %d out of bounds\n", tag);
+		return;
+	}
+
+	apple_asp_handle_cq(asp, tag, status);
+}
+
+static void apple_asp_rtkit_epmap_done(void *cookie)
+{
+	struct apple_asp *asp = cookie;
+	int ret;
+	u16 major_ver, minor_ver;
+
+	apple_rtkit_protocol_version(asp->rtk, &major_ver, &minor_ver);
+
+	if (major_ver == 10 && minor_ver < 2)
+		asp->ep = 0x5;
+	else if (major_ver == 10)
+		asp->ep = 0x6;
+	else
+		asp->ep = 0x20;
+
+	if (!asp->ep) {
+		dev_err(asp->dev, "Could not determine ASP endpoint");
+		return;
+	}
+
+	dev_dbg(asp->dev, "ASP endpoint is %d", asp->ep);
+
+	ret = apple_rtkit_start_ep(asp->rtk, asp->ep);
+	if (ret < 0) {
+		dev_err(asp->dev, "Could not start ASP endpoint: %d", ret);
+		return;
+	}
+}
+
+static const struct apple_rtkit_ops apple_asp_rtkit_ops = {
+	.crashed = apple_asp_rtkit_crashed,
+	.recv_message = apple_asp_rtkit_recv,
+	.epmap_done = apple_asp_rtkit_epmap_done,
+};
+
+static bool confirm_j72_readonly;
+module_param(confirm_j72_readonly,bool,0400);
+MODULE_PARM_DESC(confirm_j72_readonly,"Use diagnostic read-only mode unless the bounded write test is armed");
+
+static int apple_asp_probe(struct platform_device *pdev)
+{
+	struct apple_asp *asp;
+        struct device *dev = &pdev->dev;
+	struct resource *res;
+	int ret;
+
+	if (!of_machine_is_compatible("apple,j72") ||
+	    (confirm_j72_write_test && !confirm_j72_readonly))
+		return -ENODEV;
+	asp = devm_kzalloc(dev, sizeof(*asp), GFP_KERNEL);
+	if (!asp)
+		return -ENOMEM;
+	asp->write_policy.full_disk = !confirm_j72_readonly;
+	asp->write_policy.enabled = asp->write_policy.full_disk || confirm_j72_write_test;
+	asp->write_policy.first = j72_write_first_lba;
+	asp->write_policy.last = j72_write_last_lba;
+
+	asp->akf_base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(asp->akf_base))
+		return PTR_ERR(asp->akf_base);
+
+	asp->dev = dev;
+
+	/* limit of ARMv7 long descriptor format */
+	if (dma_set_mask_and_coherent(dev, DMA_BIT_MASK(40)))
+		return -ENXIO;
+
+	/* The recovery kernel supports module unload. This observer deliberately
+	 * retains DMA and callbacks after a fault, so pin its code until reboot.
+	 */
+	if (!try_module_get(THIS_MODULE))
+		return -ENODEV;
+
+	ret = apple_asp_setup_firmware(asp);
+	if (ret < 0)
+		return ret;
+
+	asp->rtk = devm_apple_rtkit_init(dev, asp, NULL, 0, &apple_asp_rtkit_ops);
+	if (IS_ERR(asp->rtk)) {
+		ret = dev_err_probe(dev, PTR_ERR(asp->rtk),
+				    "Failed to initialize RTKit");
+		goto out_stop_iop;
+	}
+
+	init_completion(&asp->init_done);
+
+	ret = apple_rtkit_wake(asp->rtk);
+	if (ret) {
+		ret = dev_err_probe(dev, ret, "Failed to wake ASP");
+		goto out_stop_iop;
+	}
+
+	/* error already printed in apple_asp_rtkit_epmap_done() */
+	if (!asp->ep) {
+		ret = -ENXIO;
+		goto out_rtkit;
+	}
+
+	if (!wait_for_completion_timeout(&asp->init_done,
+					msecs_to_jiffies(ASP_TIMEOUT_MS))) {
+		ret = dev_err_probe(dev, -ETIMEDOUT, "ASP Init timeout");
+		goto out_rtkit;
+	}
+
+	if (asp->init_ret < 0) {
+		ret = dev_err_probe(dev, asp->init_ret, "ASP Init Error");
+		goto out_rtkit;
+	}
+
+	platform_set_drvdata(pdev, asp);
+
+	dev_dbg(dev, "ASP is alive!");
+
+	ret = apple_asp_start_disk(asp);
+	if (ret < 0)
+		goto out_rtkit;
+
+	return 0;
+
+out_rtkit:
+out_stop_iop:
+	WRITE_ONCE(asp->failed,true);
+	platform_set_drvdata(pdev,asp);
+	dev_err(dev,"ASP qualification stopped (%d); resources retained; reboot required\n",ret);
+	return 0;
+}
+
+/* This observer never tears down a live DMA owner. The target has no
+ * module unload and no bind/unbind interface. On shutdown, retain all
+ * buffers and mappings until the platform reboot resets the coprocessor.
+ * This also handles a bound probe failure with only partial allocation.
+ */
+static void apple_asp_remove(struct platform_device *pdev)
+{
+	struct apple_asp *asp = platform_get_drvdata(pdev);
+
+	if (asp)
+		WRITE_ONCE(asp->failed, true);
+	dev_notice(&pdev->dev, "ASP qualification shutdown: resources retained until platform reset\n");
+}
+
+
+static const struct of_device_id apple_asp_of_match[] = {
+	{ .compatible = "apple,s5l8960x-ans" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, apple_asp_of_match);
+
+static struct platform_driver apple_asp_driver = {
+	.driver = {
+		.name = "apple-asp",
+		.suppress_bind_attrs = true,
+		.of_match_table = apple_asp_of_match,
+	},
+	.probe = apple_asp_probe,
+	.remove = apple_asp_remove,
+	.shutdown = apple_asp_remove,
+};
+
+module_platform_driver(apple_asp_driver);
+
+MODULE_LICENSE("Dual MIT/GPL");
+MODULE_DESCRIPTION("Apple ANS1 Storage Processor Driver");
+MODULE_AUTHOR("Nick Chan <towinchenmi@gmail.com>");
diff --git a/drivers/block/j72-asp-bounds.h b/drivers/block/j72-asp-bounds.h
new file mode 100644
index 000000000..29ffa5dba
--- /dev/null
+++ b/drivers/block/j72-asp-bounds.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef J72_ASP_BOUNDS_H
+#define J72_ASP_BOUNDS_H
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdint.h>
+#include <stdbool.h>
+typedef uint64_t u64;
+typedef uint32_t u32;
+#endif
+#define J72_ASP_PAGE 4096u
+#define J72_ASP_SGL_MAX 4068u
+static inline bool j72_asp_request_valid(u64 capacity, u64 sector512, u32 bytes)
+{
+ u64 lba=sector512>>3, blocks=bytes>>12;
+ return capacity && capacity<=0x100000000ULL && !(sector512&7) && bytes &&
+        !(bytes&4095) && blocks<=J72_ASP_SGL_MAX && lba<=0xffffffffULL &&
+        lba<capacity && blocks<=capacity-lba;
+}
+static inline bool j72_asp_sg_valid(u64 address,u32 bytes,u32 used,u32 expected)
+{
+ u64 mask=(1ULL<<40)-1;
+ u32 pages=bytes>>12;
+ return bytes && !(bytes&4095) && !(address&4095) && address<=mask &&
+        (u64)bytes-1<=mask-address && used<=J72_ASP_SGL_MAX &&
+        pages<=J72_ASP_SGL_MAX-used && used<=expected && pages<=expected-used;
+}
+#endif
diff --git a/drivers/block/j72-asp-write-policy.h b/drivers/block/j72-asp-write-policy.h
new file mode 100644
index 000000000..6c7511139
--- /dev/null
+++ b/drivers/block/j72-asp-write-policy.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef J72_ASP_WRITE_POLICY_H
+#define J72_ASP_WRITE_POLICY_H
+#include "j72-asp-bounds.h"
+
+struct j72_asp_write_policy {
+	u64 capacity;
+	u64 first;
+	u64 last;
+	bool enabled;
+	bool full_disk;
+	bool unlocked;
+};
+
+static inline bool j72_asp_write_range_valid(const struct j72_asp_write_policy *p)
+{
+	if (p->full_disk)
+		return p->capacity > 11 && p->capacity <= 0x100000000ULL;
+	/* The measured GPT uses six primary blocks and five backup blocks.
+	 * A qualification range may never overlap either GPT copy or the MBR.
+	 * The host additionally binds this range to verified unallocated space.
+	 */
+	return p->capacity > 11 && p->capacity <= 0x100000000ULL &&
+	       p->first >= 6 && p->first <= p->last &&
+	       p->last < p->capacity - 5;
+}
+
+static inline bool j72_asp_rw_allowed(const struct j72_asp_write_policy *p,
+				     u64 sector512, u32 bytes, bool write)
+{
+	u64 first = sector512 >> 3;
+	u64 blocks = bytes >> 12;
+
+	if (!j72_asp_request_valid(p->capacity, sector512, bytes))
+		return false;
+	if (!write)
+		return true;
+	return p->enabled && p->unlocked && j72_asp_write_range_valid(p) &&
+	       (p->full_disk || (first >= p->first && first <= p->last &&
+			       blocks <= p->last - first + 1));
+}
+
+static inline bool j72_asp_admin_allowed(const struct j72_asp_write_policy *p,
+					u32 opcode)
+{
+	switch (opcode) {
+	case 0x00: /* Identify; also needed before capacity is known. */
+		return true;
+	case 0x19: /* Controller-wide unlock: no auxiliary write command exposed. */
+		return p->enabled && !p->unlocked && j72_asp_write_range_valid(p);
+	case 0x13: /* Explicit firmware flush; success must come from hardware. */
+		return p->enabled && p->unlocked && j72_asp_write_range_valid(p);
+	default:
+		/* Reject format, discard, auxiliary writes and unknown admin ops. */
+		return false;
+	}
+}
+
+/* Repeat admission on the encoded header immediately before the doorbell. */
+static inline bool j72_asp_command_allowed(const struct j72_asp_write_policy *p,
+					  u32 opcode, u32 flags, u64 lba, u32 blocks)
+{
+	if (opcode == 0x10 || opcode == 0x11) {
+		if (flags != 8 || !blocks || blocks > J72_ASP_SGL_MAX ||
+		    lba > 0xffffffffULL)
+			return false;
+		return j72_asp_rw_allowed(p, lba << 3, blocks << 12, opcode == 0x11);
+	}
+	return !flags && !lba && !blocks && j72_asp_admin_allowed(p, opcode);
+}
+#endif
