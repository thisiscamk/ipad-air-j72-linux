diff --git a/drivers/clk/clk-apple-s5l8960x-touch.c b/drivers/clk/clk-apple-s5l8960x-touch.c
new file mode 100644
index 000000000..5102fc503
--- /dev/null
+++ b/drivers/clk/clk-apple-s5l8960x-touch.c
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* Apple S5L8960X touchscreen reference clock, generated by PWM0 channel 2. */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#define S5L_TOUCH_COUNT_ON	0x10
+#define S5L_TOUCH_COUNT_OFF	0x14
+#define S5L_TOUCH_CTRL		0x20
+#define S5L_TOUCH_ENABLE		BIT(0)
+#define S5L_TOUCH_UPDATE		BIT(1)
+#define S5L_TOUCH_OUTPUT_ENABLE	BIT(14)
+
+struct apple_s5l_touch_clk {
+	struct clk_hw hw;
+	struct device *dev;
+	void __iomem *base;
+	u32 rate;
+	u32 saved_on;
+	u32 saved_off;
+	u32 saved_ctrl;
+	bool prepared;
+};
+
+#define to_apple_s5l_touch_clk(_hw) \
+	container_of(_hw, struct apple_s5l_touch_clk, hw)
+
+static u32 apple_s5l_touch_half_period(unsigned long parent_rate, u32 rate)
+{
+	u64 half;
+
+	if (!rate)
+		return 0;
+
+	half = DIV_ROUND_CLOSEST_ULL((u64)parent_rate, (u64)rate * 2);
+	if (!half || half > U32_MAX)
+		return 0;
+
+	return half;
+}
+
+static void apple_s5l_touch_clk_restore(struct apple_s5l_touch_clk *clk)
+{
+	/* Stop before restoring the two channel-2 count words. */
+	writel(0, clk->base + S5L_TOUCH_CTRL);
+	readl(clk->base + S5L_TOUCH_CTRL);
+	writel(clk->saved_on, clk->base + S5L_TOUCH_COUNT_ON);
+	writel(clk->saved_off, clk->base + S5L_TOUCH_COUNT_OFF);
+	writel(clk->saved_ctrl, clk->base + S5L_TOUCH_CTRL);
+	readl(clk->base + S5L_TOUCH_CTRL);
+}
+
+static int apple_s5l_touch_clk_prepare(struct clk_hw *hw)
+{
+	struct apple_s5l_touch_clk *clk = to_apple_s5l_touch_clk(hw);
+	unsigned long parent_rate = clk_hw_get_rate(clk_hw_get_parent(hw));
+	u32 half, ctrl;
+	int ret;
+
+	half = apple_s5l_touch_half_period(parent_rate, clk->rate);
+	if (!half)
+		return -EINVAL;
+
+	ret = pm_runtime_resume_and_get(clk->dev);
+	if (ret < 0)
+		return ret;
+
+	clk->saved_ctrl = readl(clk->base + S5L_TOUCH_CTRL);
+	/* An already configured channel needs a separate handover policy. */
+	if (clk->saved_ctrl) {
+		ret = -EBUSY;
+		goto out_power;
+	}
+	clk->saved_on = readl(clk->base + S5L_TOUCH_COUNT_ON);
+	clk->saved_off = readl(clk->base + S5L_TOUCH_COUNT_OFF);
+
+	writel(half, clk->base + S5L_TOUCH_COUNT_ON);
+	writel(half, clk->base + S5L_TOUCH_COUNT_OFF);
+	writel(S5L_TOUCH_ENABLE | S5L_TOUCH_UPDATE | S5L_TOUCH_OUTPUT_ENABLE,
+	       clk->base + S5L_TOUCH_CTRL);
+	ret = readl_poll_timeout(clk->base + S5L_TOUCH_CTRL, ctrl,
+				 !(ctrl & S5L_TOUCH_UPDATE), 1, 1000);
+	if (ret)
+		goto restore;
+	if (ctrl != (S5L_TOUCH_ENABLE | S5L_TOUCH_OUTPUT_ENABLE) ||
+	    readl(clk->base + S5L_TOUCH_COUNT_ON) != half ||
+	    readl(clk->base + S5L_TOUCH_COUNT_OFF) != half) {
+		ret = -EIO;
+		goto restore;
+	}
+
+	clk->prepared = true;
+	return 0;
+
+restore:
+	apple_s5l_touch_clk_restore(clk);
+out_power:
+	pm_runtime_put_sync(clk->dev);
+	return ret;
+}
+
+static void apple_s5l_touch_clk_unprepare(struct clk_hw *hw)
+{
+	struct apple_s5l_touch_clk *clk = to_apple_s5l_touch_clk(hw);
+
+	apple_s5l_touch_clk_restore(clk);
+	if (readl(clk->base + S5L_TOUCH_CTRL) != clk->saved_ctrl ||
+	    readl(clk->base + S5L_TOUCH_COUNT_ON) != clk->saved_on ||
+	    readl(clk->base + S5L_TOUCH_COUNT_OFF) != clk->saved_off)
+		dev_err(clk->dev, "touch clock restoration readback failed\n");
+	clk->prepared = false;
+	pm_runtime_put_sync(clk->dev);
+}
+
+static int apple_s5l_touch_clk_is_prepared(struct clk_hw *hw)
+{
+	return to_apple_s5l_touch_clk(hw)->prepared;
+}
+
+static unsigned long
+apple_s5l_touch_clk_recalc_rate(struct clk_hw *hw, unsigned long parent_rate)
+{
+	struct apple_s5l_touch_clk *clk = to_apple_s5l_touch_clk(hw);
+	u32 half = apple_s5l_touch_half_period(parent_rate, clk->rate);
+
+	return half ? div64_u64(parent_rate, (u64)half * 2) : 0;
+}
+
+static const struct clk_ops apple_s5l_touch_clk_ops = {
+	.prepare = apple_s5l_touch_clk_prepare,
+	.unprepare = apple_s5l_touch_clk_unprepare,
+	.is_prepared = apple_s5l_touch_clk_is_prepared,
+	.recalc_rate = apple_s5l_touch_clk_recalc_rate,
+};
+
+static int apple_s5l_touch_clk_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_parent_data parent = { .index = 0 };
+	struct clk_init_data init = {
+		.ops = &apple_s5l_touch_clk_ops,
+		.parent_data = &parent,
+		.num_parents = 1,
+	};
+	struct apple_s5l_touch_clk *clk;
+	int ret;
+
+	clk = devm_kzalloc(dev, sizeof(*clk), GFP_KERNEL);
+	if (!clk)
+		return -ENOMEM;
+	clk->dev = dev;
+	clk->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(clk->base))
+		return PTR_ERR(clk->base);
+
+	ret = of_property_read_u32(dev->of_node, "clock-frequency", &clk->rate);
+	if (ret || clk->rate != 32768)
+		return dev_err_probe(dev, -EINVAL, "unsupported touch reference rate\n");
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	init.name = dev_name(dev);
+	clk->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &clk->hw);
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &clk->hw);
+}
+
+static const struct of_device_id apple_s5l_touch_clk_of_match[] = {
+	{ .compatible = "apple,s5l8960x-touch-clock" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_s5l_touch_clk_of_match);
+
+static struct platform_driver apple_s5l_touch_clk_driver = {
+	.probe = apple_s5l_touch_clk_probe,
+	.driver = {
+		.name = "apple-s5l8960x-touch-clk",
+		.of_match_table = apple_s5l_touch_clk_of_match,
+	},
+};
+module_platform_driver(apple_s5l_touch_clk_driver);
+
+MODULE_DESCRIPTION("Apple S5L8960X touchscreen reference clock");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
index 161ebb4b8..92a717362 100644
--- a/drivers/input/touchscreen/apple_z2.c
+++ b/drivers/input/touchscreen/apple_z2.c
@@ -29,6 +29,7 @@
 #include <linux/workqueue.h>
 
 #include "apple_z2_n61.h"
+#include "apple_z2_j72.h"
 
 #define APPLE_Z2_NUM_FINGERS_OFFSET      16
 #define APPLE_Z2_FINGERS_OFFSET          24
@@ -144,6 +145,7 @@ enum apple_z2_variant {
 	APPLE_Z2_VARIANT_D11,
 	APPLE_Z2_VARIANT_D111,
 	APPLE_Z2_VARIANT_N61,
+	APPLE_Z2_VARIANT_J72,
 };
 
 struct apple_z2_hbpp_reg {
@@ -157,6 +159,8 @@ struct apple_z2_hbpp_reg {
  * @num_calib_regs:	number of entries in @calib_regs
  * @execute_addr:	firmware entry point (fw-execute-addr)
  * @execute_arg:	execute command argument
