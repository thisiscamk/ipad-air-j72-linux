#!/bin/bash
# RAM session controller for the source-built Wayland keyboard.
set -eu
binary=/home/tablet/.local/bin/j72-wvkbd-auto
runtime=${XDG_RUNTIME_DIR:?}
pid_file=$runtime/omarchy-keyboard.pid
state_file=$runtime/omarchy-keyboard-visible
live_pid() {
 local pid
 [[ -f "$pid_file" ]] || return 1
 read -r pid < "$pid_file"
 [[ "$pid" =~ ^[0-9]+$ ]] || return 1
 [[ $(readlink "/proc/$pid/exe" 2>/dev/null) == "$binary" ]] || return 1
 printf '%s' "$pid"
}
case ${1:-run} in
 run)
  if live_pid >/dev/null; then exit 0; fi
  printf '0\n' > "$state_file"
  printf '%s\n' "$$" > "$pid_file"
  export WVKBD_STATE_FILE=$state_file
  exec "$binary" --auto --hidden --no-popup -H 270 -L 220 --bg 1a1b26 --fg 24283b --fg-sp 292e42 --press 7aa2f7 --press-sp 7aa2f7 --text a9b1d6 --text-sp c0caf5
  ;;
 toggle)
  if pid=$(live_pid); then kill -RTMIN "$pid"; exit 0; fi
  "$0" run < /dev/null >> "$runtime/omarchy-keyboard.log" 2>&1 &
  for ((i=0;i<40;i++)); do
   if pid=$(live_pid); then kill -USR2 "$pid"; exit 0; fi
   sleep 0.05
  done
  echo 'Keyboard did not start' >&2; exit 1
  ;;
 *) echo 'usage: omarchy-keyboard [run|toggle]' >&2; exit 2;;
esac
