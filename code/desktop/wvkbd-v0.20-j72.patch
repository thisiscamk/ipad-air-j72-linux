+/* Report the actual layer-surface state to the tablet shell. No protocol or
+ * key behavior changes; absent WVKBD_STATE_FILE this is upstream behavior. */
+static void report_visibility(bool visible)
+{
+    const char *path = getenv("WVKBD_STATE_FILE");
+    if (!path || !*path) return;
+    FILE *file = fopen(path, "w");
+    if (!file) return;
+    fputs(visible ? "1\n" : "0\n", file);
+    fclose(file);
+}
 
