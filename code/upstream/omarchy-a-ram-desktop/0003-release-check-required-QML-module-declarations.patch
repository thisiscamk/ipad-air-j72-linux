diff --git a/tests/test_ram_desktop.py b/tests/test_ram_desktop.py
index 2935d3c..f7244e1 100644
--- a/tests/test_ram_desktop.py
+++ b/tests/test_ram_desktop.py
@@ -291,6 +291,29 @@ class RamDesktop(unittest.TestCase):
         self.assertEqual(set(selected), {theme + '/jade-horse/colors.toml',
                          'usr/lib/qt6/plugins/platforms/libqwayland-generic.so'})
 
+    def test_qml_module_requirements_refuse_missing_core_metadata_and_ignore_optional_import(self):
+        self.put('usr/lib/qt6/qml/QtQml/qmldir',
+                 b'module QtQml\nimport QML 1.0\noptional import Unused.Module auto\n')
+        self.put('ui/shell.qml', b'import QtQml\nimport "local"\n')
+        source = ram.Source(self.root)
+        selected, _ = ram.selection(source, ['ui/shell.qml'], ['usr/lib/qt6/qml/QtQml'])
+        with self.assertRaisesRegex(ValueError, 'Required QML import absent.*QML'):
+            ram.verify_qml_imports(source, selected)
+        self.put('usr/lib/qt6/qml/QML/qmldir', b'module QML\nstatic\nsystem\n')
+        selected, _ = ram.selection(source, ['ui/shell.qml'], ['usr/lib/qt6/qml'])
+        result = ram.verify_qml_imports(source, selected)
+        self.assertEqual(set(result['required_imports']), {'QML', 'QtQml'})
+        self.assertIn('RUNTIME_UNTESTED', result['status'])
+        plugin = ram.UI + '/shell/plugins/lock/'
+        self.put(plugin + 'manifest.json', b'{"id":"omarchy.lock"}')
+        self.put(plugin + 'LockFeedSurface.qml', b'import Owe.LockFeed\n')
+        selected, _ = ram.selection(source, ['ui/shell.qml'], ['usr/lib/qt6/qml', plugin])
+        with self.assertRaisesRegex(ValueError, 'Required QML import absent.*Owe.LockFeed'):
+            ram.verify_qml_imports(source, selected)
+        result = ram.verify_qml_imports(source, selected, disabled_plugins=['omarchy.lock'])
+        self.assertEqual(result['disabled_plugin_sources_not_required'], [plugin + 'LockFeedSurface.qml'])
+        self.assertEqual(set(result['required_imports']), {'QML', 'QtQml'})
+
 
 if __name__ == '__main__':
     unittest.main()
