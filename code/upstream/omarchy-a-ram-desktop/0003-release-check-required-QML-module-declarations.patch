+def verify_qml_imports(source, selected, *, disabled_plugins=()):
+    """Check static imports, including native module qmldir requirements.
+
+    This does not execute QML, prove type availability or resolve arbitrary
+    computed URLs. Disabled plugin source files remain in the image, but their
+    imports do not become requirements of this explicit compact profile.
+    """
+    modules, required, skipped = {}, {}, []
+    disabled_directories = []
+    for label in selected:
+        if label.startswith(UI + '/shell/plugins/') and label.endswith('manifest.json'):
+            manifest = json.loads(source.file(label).read_text())
+            if manifest.get('id') in disabled_plugins:
+                disabled_directories.append(str(PurePosixPath(label).parent) + '/')
+    for label in selected:
+        if Path(label).name == 'qmldir':
+            text = source.file(label).read_text()
+            declared = re.findall(r'^module\s+([\w.]+)', text, flags=re.M)
+            for name in declared:
+                if name in modules:
+                    raise ValueError('Ambiguous selected QML module: ' + name)
+                modules[name] = label
+            names = re.findall(r'^(?:default\s+)?(?:import|depends)\s+([\w.]+)', text, flags=re.M)
+        elif label.endswith(('.qml', '.js')):
+            if any(label.startswith(directory) for directory in disabled_directories):
+                skipped.append(label)
+                continue
+            text = source.file(label).read_text()
+            names = re.findall(r'^\s*import\s+([A-Za-z_][\w.]*)', text, flags=re.M)
+        else:
+            continue
+        for name in names:
+            required.setdefault(name, []).append(label)
+    missing = sorted(set(required) - set(modules))
+    if missing:
+        raise ValueError('Required QML import absent from selection: ' + ', '.join(missing))
+    return {'status': 'STATIC_DECLARATIONS_CHECKED_RUNTIME_UNTESTED',
+            'modules': modules, 'required_imports': required,
+            'disabled_plugin_sources_not_required': skipped}
+
