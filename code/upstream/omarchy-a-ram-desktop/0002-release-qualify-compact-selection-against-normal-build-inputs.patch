+    if not allowed.issubset(plugins):
+        raise ValueError('Missing normal compact-profile plugins')
+    config.update(idle={'screensaver': 0, 'lock': 0},
+                  disabledPlugins=sorted(plugins - allowed), plugins=[])
+    config['bar'] = {'position': 'top', 'background': 'opaque', 'layout': {
+        'left': [{'id': 'omarchy.menu'}], 'centerBegin': [],
+        'center': [{'id': 'omarchy.clock', 'format': 'HH:mm'}], 'centerEnd': [],
+        'right': [{'id': 'ipadlinux.keyboard'}]}}
+    rc = ET.fromstring((source.root / rc_path).read_bytes())
+    keyboard = rc.find('keyboard')
+    if keyboard is None:
+        raise ValueError('Missing normal Labwc keyboard bindings')
+    for defaults in keyboard.findall('default'):
+        keyboard.remove(defaults)
+    menu_command = 'omarchy-shell shell toggle omarchy.menu \'{"menu":"root"}\''
+    for binding in list(keyboard.findall('keybind')):
+        for action in binding.findall('action'):
+            if action.get('name') != 'Execute':
+                continue
+            command = action.get('command', '')
+            if command.startswith('omarchy-shell ') or binding.get('key') == 'XF86HomePage':
+                action.set('command', menu_command)
+            elif command != 'foot':
+                keyboard.remove(binding)
+                break
+    encoded = lambda value: (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()
+    files = {shell_path: encoded(config), rc_path: ET.tostring(rc, encoding='utf-8', xml_declaration=True),
+             'home/tablet/.config/omarchy/extensions/omarchy-menu.jsonc': encoded(extension)}
+    owner = (source.root / 'home/tablet').stat()
+    result = {}
+    for label, data in files.items():
+        original = source.root / label
+        if original.is_symlink() or (label.endswith('/extensions/omarchy-menu.jsonc') and original.exists()):
+            raise ValueError('Compact profile requires a clean normal base root')
+        result[label] = {'data': data, 'original_sha256': digest(original) if original.is_file() else None,
+                         'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data),
+                         'uid': owner.st_uid, 'gid': owner.st_gid, 'mode': 0o644}
+    return result
+
