+        receipts[name] = {'manifest_sha256': digest(directory / 'manifest.json'), 'receipt': record}
+        for label, (data, mode) in files.items():
+            # Generated helper receipts remain in the outer build receipt;
+            # install the normal binaries, licenses and corresponding source.
+            if label.startswith('etc/omarchy/'):
+                continue
+            original = 'wtype' if label == 'usr/libexec/omarchy-wtype' else Path(label).name
