+    menu_path = UI + '/default/omarchy/omarchy-menu.jsonc'
+    menu_raw = (source.root / menu_path).read_text()
+    # Match the normal menu reader's JSONC contract: whole-line comments and
+    # trailing commas. Refuse unsupported input instead of guessing at rows.
+    menu = json.loads(re.sub(r',(\s*[}\]])', r'\1',
+                            re.sub(r'^\s*//[^\n]*(?:\n|$)', '', menu_raw, flags=re.M)))
+    entries = menu.get('items', menu)
+    if not isinstance(entries, dict) or not entries or any(
+            not isinstance(key, str) or not isinstance(value, dict) for key, value in entries.items()):
+        raise ValueError('Unsupported normal menu definition')
+    extension = {key: {'when': 'false'} for key in entries}
+    extension.update({
+        'root': {'label': 'Omarchy A RAM'},
+        'ram-terminal': {'parent': 'root', 'label': 'Terminal', 'action': 'foot'},
+        'ram-keyboard': {'parent': 'root', 'label': 'Keyboard', 'action': 'omarchy-keyboard toggle'},
+    })
+    config = json.loads((source.root / shell_path).read_text())
+    if config.get('version') != 1:
