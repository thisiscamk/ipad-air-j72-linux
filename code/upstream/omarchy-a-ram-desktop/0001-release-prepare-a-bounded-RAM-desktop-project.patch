+"""Bounded subset staging; no large build, source root or device required."""
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import struct
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from release import ram_desktop as ram
+
+
+class RamDesktop(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name) / 'root'
+        self.root.mkdir()
+
+    def put(self, name, data=b'data'):
+        path = self.root / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(data)
+        return path
+
+    def test_closure_resolves_elf_interpreter_needed_origin_and_root_symlinks(self):
+        self.put('usr/bin/app')
+        self.put('usr/lib/ld.so')
+        self.put('usr/lib/libfirst.so')
+        self.put('usr/lib/libsecond.so')
+        self.put('usr/share/qml/module.qml')
+        (self.root / 'lib').symlink_to('usr/lib')
+        (self.root / 'usr/lib/libalias.so').symlink_to('libfirst.so')
+
+        def dependencies(path):
+            if path.name == 'app':
+                return ['libalias.so'], ['$ORIGIN/../lib'], '/lib/ld.so'
+            if path.name == 'libfirst.so':
+                return ['libsecond.so'], [], None
+            return [], [], None
+
+        source = ram.Source(self.root)
+        selected, total = ram.selection(source, ['usr/bin/app'], ['usr/share/qml'],
+                                        dependencies=dependencies)
+        self.assertEqual(set(selected), {'usr/bin/app', 'usr/lib/ld.so',
+                         'usr/lib/libfirst.so', 'usr/lib/libsecond.so', 'usr/share/qml/module.qml'})
+        self.assertEqual(total, 20)
+        target = Path(self.temp.name) / 'subset'
+        ram.stage(source, selected, target)
+        self.assertEqual((target / 'lib').readlink(), Path('usr/lib'))
+        self.assertEqual((target / 'usr/lib/libalias.so').readlink(), Path('libfirst.so'))
+        self.assertEqual((target / 'usr/lib/libalias.so').read_bytes(), b'data')
+
+    def test_missing_dependency_and_data_or_over_budget_refuse(self):
+        self.put('usr/bin/app')
+        with self.assertRaisesRegex(ValueError, 'Unresolved ELF'):
+            ram.selection(ram.Source(self.root), ['usr/bin/app'], [],
+                          dependencies=lambda _: (['missing.so'], [], None))
+        with self.assertRaisesRegex(ValueError, 'data directory'):
+            ram.selection(ram.Source(self.root), [], ['missing'])
+        with self.assertRaisesRegex(ValueError, 'declared limit'):
+            ram.selection(ram.Source(self.root), ['usr/bin/app'], [], expanded_limit=3)
+
+    def test_symlink_escape_and_cycles_refuse(self):
+        (self.root / 'escape').symlink_to('../outside')
+        (self.root / 'cycle').symlink_to('cycle')
+        for name in ('escape', 'cycle'):
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                ram.Source(self.root).resolve(name)
+
+    def test_source_mutation_refuses_before_staging_changed_bytes(self):
+        path = self.put('usr/bin/app')
+        source = ram.Source(self.root)
+        selected, _ = ram.selection(source, ['usr/bin/app'], [])
+        path.write_bytes(b'changed')
+        with self.assertRaisesRegex(ValueError, 'changed during staging'):
+            ram.stage(source, selected, Path(self.temp.name) / 'subset')
+
+    def test_provenance_ties_normal_component_manifest_and_package_receipt(self):
+        desktop = Path(self.temp.name) / 'desktop'
+        (desktop / 'payload').mkdir(parents=True)
+        manifest = b'{"some-file":"some-hash"}'
+        (desktop / 'payload/arch-ipad-ui-manifest.json').write_bytes(manifest)
+        (desktop / 'manifest.json').write_text(json.dumps(
+            {'payload_manifest_sha256': hashlib.sha256(manifest).hexdigest()}))
+        self.put('arch-ipad-ui-manifest.json', manifest)
+        packages = Path(self.temp.name) / 'packages.lock'
+        packages.write_bytes(b'normal packages\n')
+        receipt = Path(self.temp.name) / 'rootfs.tar.gz.json'
+        receipt.write_text(json.dumps({'packages_lock_sha256': ram.digest(packages)}))
+        ram.verify_inputs(self.root, desktop, receipt, packages)
+        packages.write_bytes(b'changed')
+        with self.assertRaisesRegex(ValueError, 'packages.lock differs'):
+            ram.verify_inputs(self.root, desktop, receipt, packages)
+
+    def test_non_aarch64_or_truncated_elf_refuses(self):
+        for blob in (b'\x7fELF', b'\x7fELF' + bytes(60)):
+            with self.subTest(blob=blob), self.assertRaisesRegex(ValueError, 'AArch64 ELF'):
+                ram.elf_dependencies(self.put('app', blob))
+
+    def test_scripts_and_absolute_data_directory_symlink_stay_in_source_root(self):
+        self.put('usr/bin/script', b'#!/usr/bin/env python3\n')
+        self.put('usr/bin/env')
+        self.put('usr/bin/python3.13')
+        (self.root / 'usr/bin/python3').symlink_to('python3.13')
+        self.put('usr/lib/python3.13/tomllib/__init__.py')
+        self.put('usr/lib/python3.13/site-packages/unused.py')
+        self.put('unique-fixture-data/file')
+        (self.root / 'data-alias').symlink_to('/unique-fixture-data')
+        selected, _ = ram.selection(ram.Source(self.root), ['usr/bin/script'], ['data-alias'])
+        self.assertTrue({'usr/bin/env', 'usr/bin/python3.13',
+                         'usr/lib/python3.13/tomllib/__init__.py',
+                         'unique-fixture-data/file'}.issubset(selected))
+        self.assertNotIn('usr/lib/python3.13/site-packages/unused.py', selected)
+        self.put('usr/bin/script', b'#!/usr/bin/env -S python3 -I\n')
+        with self.assertRaisesRegex(ValueError, 'Unsupported env'):
+            ram.selection(ram.Source(self.root), ['usr/bin/script'], [])
+
+    def test_relative_loader_search_and_changed_symlink_refuse(self):
+        self.put('usr/bin/app')
+        with self.assertRaisesRegex(ValueError, 'Relative ELF'):
+            ram.selection(ram.Source(self.root), ['usr/bin/app'], [],
+                          dependencies=lambda _: ([], ['../lib'], None))
+        alias = self.root / 'app'
+        alias.symlink_to('usr/bin/app')
+        source = ram.Source(self.root)
+        selected, _ = ram.selection(source, ['app'], [])
+        alias.unlink()
+        alias.symlink_to('other')
+        with self.assertRaisesRegex(ValueError, 'symlink changed'):
+            ram.stage(source, selected, Path(self.temp.name) / 'subset')
+
+    @unittest.skipUnless(shutil.which('readelf'), 'readelf required by producer')
+    def test_real_readelf_reads_synthetic_aarch64_dynamic_and_interpreter(self):
+        # Small ELF with ordinary section headers; no executable code or host ELF.
+        interp = b'/lib/ld-linux-aarch64.so.1\0'
+        strings = b'\0libthing.so\0$ORIGIN/../lib\0'
+        start = 64 + 3 * 56
+        strings_offset = start + len(interp)
+        dynamic = b''.join(struct.pack('<QQ', tag, value) for tag, value in
+                           ((1, strings.index(b'libthing')), (29, strings.index(b'$ORIGIN')),
+                            (5, strings_offset), (10, len(strings)), (0, 0)))
+        names = b'\0.dynstr\0.dynamic\0.shstrtab\0'
+        offsets = (strings_offset, strings_offset + len(strings),
+                   strings_offset + len(strings) + len(dynamic))
+        shoff = offsets[2] + len(names)
+        ident = b'\x7fELF\x02\x01\x01' + bytes(9)
+        header = struct.pack('<16sHHIQQQIHHHHHH', ident, 3, 183, 1, 0, 64, shoff,
+                             0, 64, 56, 3, 64, 4, 3)
+        size = shoff + 4 * 64
+        program = struct.pack('<IIQQQQQQ', 1, 4, 0, 0, 0, size, size, 1)
+        program += struct.pack('<IIQQQQQQ', 3, 4, start, start, start, len(interp), len(interp), 1)
+        program += struct.pack('<IIQQQQQQ', 2, 4, offsets[1], offsets[1], offsets[1],
+                               len(dynamic), len(dynamic), 8)
+        sections = bytes(64)
+        for name, kind, offset, size, link, entry_size in (
+                (1, 3, offsets[0], len(strings), 0, 0),
+                (9, 6, offsets[1], len(dynamic), 1, 16),
+                (18, 3, offsets[2], len(names), 0, 0)):
+            sections += struct.pack('<IIQQQQIIQQ', name, kind, 0, 0, offset, size, link, 0, 1, entry_size)
+        path = self.put('app', header + program + interp + strings + dynamic + names + sections)
+        self.assertEqual(ram.elf_dependencies(path),
+                         (['libthing.so'], ['$ORIGIN/../lib'], '/lib/ld-linux-aarch64.so.1'))
+
+    def test_selected_component_file_changes_refuse_even_with_unchanged_manifest(self):
+        desktop = Path(self.temp.name) / 'desktop'
+        (desktop / 'payload').mkdir(parents=True)
+        self.put('usr/bin/app', b'changed')
+        (desktop / 'payload/arch-ipad-ui-manifest.json').write_text(json.dumps(
+            {'usr/bin/app': hashlib.sha256(b'original').hexdigest()}))
+        source = ram.Source(self.root)
+        selected, _ = ram.selection(source, ['usr/bin/app'], [])
+        with self.assertRaisesRegex(ValueError, 'file differs from normal component'):
+            ram.verify_component_selection(source, selected, desktop)
+
+    def test_plan_build_and_compressed_budget_are_separate_gates(self):
+        desktop = Path(self.temp.name) / 'desktop'
+        (desktop / 'payload').mkdir(parents=True)
+        manifest = b'{}'
+        (desktop / 'payload/arch-ipad-ui-manifest.json').write_bytes(manifest)
+        (desktop / 'manifest.json').write_text(json.dumps(
+            {'payload_manifest_sha256': hashlib.sha256(manifest).hexdigest()}))
+        self.put('arch-ipad-ui-manifest.json', manifest)
+        self.put('usr/bin/app')
+        packages = Path(self.temp.name) / 'packages.lock'
+        packages.write_bytes(b'packages\n')
+        receipt = Path(self.temp.name) / 'receipt.json'
+        receipt.write_text(json.dumps({'packages_lock_sha256': ram.digest(packages)}))
+
+        def compress(command, **kwargs):
+            self.assertEqual(command[0], 'mksquashfs')
+            self.assertEqual(command[command.index('-comp') + 1], 'gzip')
+            Path(command[2]).write_bytes(b'synthetic image')
+
+        with patch.object(ram, 'PROGRAMS', ()), patch.object(ram, 'FILES', ('usr/bin/app',)), \
+                patch.object(ram, 'TREES', ()), patch.object(ram.subprocess, 'run', side_effect=compress) as run:
+            output = Path(self.temp.name) / 'plan'
+            plan = ram.produce(self.root, desktop, receipt, packages, output, plan_only=True)
+            self.assertEqual(plan['status'], 'HOST_PLAN_ONLY')
+            self.assertFalse((output / 'project').exists())
+            run.assert_not_called()
+            built = Path(self.temp.name) / 'built'
+            result = ram.produce(self.root, desktop, receipt, packages, built)
+            self.assertEqual(result['status'], 'HOST_BUILT_DEVICE_UNTESTED')
+            self.assertFalse((built / '.subset').exists())
+            self.assertEqual((built / 'project/init').read_bytes(),
+                             (ram.PROJECT / 'system/ram-desktop/init').read_bytes())
+            self.assertIn('transport = true', (built / 'project/orchard.toml').read_text())
+            self.assertFalse(result['device_tested'])
+            with self.assertRaisesRegex(ValueError, 'Compressed desktop exceeds'):
+                ram.produce(self.root, desktop, receipt, packages,
+                            Path(self.temp.name) / 'too-large', compressed_limit=1)
+
+
+if __name__ == '__main__':
+    unittest.main()
