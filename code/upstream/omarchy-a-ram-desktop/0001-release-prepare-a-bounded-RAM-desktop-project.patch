+#!/usr/bin/env python3
+"""Prepare an experimental bounded RAM project from normal Omarchy build inputs."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from release.ram_desktop import produce
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for option in ('root', 'desktop', 'source-receipt', 'packages-lock', 'output', 'orchard'):
+        parser.add_argument('--' + option, type=Path, required=True)
+    parser.add_argument('--plan-only', action='store_true')
+    parser.add_argument('--upper-mib', type=int, default=64)
+    args = parser.parse_args()
+    if not (args.orchard / 'src/orchard').is_dir():
+        parser.error('Name a normal Orchard source checkout')
+    project = Path(__file__).resolve().parents[1]
+    subprocess.run([sys.executable, str(project / 'desktop/build'), '--verify', str(args.desktop)],
+                   check=True, env={**os.environ, 'ORCHARD_CHECKOUT': str(args.orchard.resolve())})
+    record = produce(args.root, args.desktop, args.source_receipt, args.packages_lock,
+                     args.output, upper_mib=args.upper_mib, plan_only=args.plan_only)
+    print(record['status'])
+
+
+if __name__ == '__main__':
+    main()
