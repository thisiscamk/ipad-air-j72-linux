++            seat->touch.surface_kind == TERM_SURF_GRID) {
++            ime_disable(seat);
++            ime_enable(seat);
++            LOG_INFO("touch tap requested input method");
++        }
+         wl_pointer_button(seat, NULL, seat->touch.serial, time, BTN_LEFT,
+                           WL_POINTER_BUTTON_STATE_PRESSED);
+         /* fallthrough */
