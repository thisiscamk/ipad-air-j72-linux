+"""Optional Foot artifact qualification and hostile source archive regression tests."""
+import hashlib
+import importlib.util
+import io
+import json
+import subprocess
+from contextlib import ExitStack
+from pathlib import Path
+import tarfile
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from release import audit, public_root
+
+PROJECT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('foot_source', PROJECT / 'desktop/foot_source.py')
+source = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(source)
+
+
+def archive(entries):
+    data = io.BytesIO()
+    with tarfile.open(fileobj=data, mode='w:gz') as tar:
+        for name, kind in entries:
+            item = tarfile.TarInfo(name)
+            item.mode = 0o4777
+            if kind == 'file':
+                item.size = 1
+                tar.addfile(item, io.BytesIO(b'x'))
+            else:
+                item.type = tarfile.SYMTYPE if kind == 'link' else tarfile.DIRTYPE
+                item.linkname = '/etc/passwd'
+                tar.addfile(item)
+    return data.getvalue()
+
+
+class FootSource(unittest.TestCase):
+    def test_source_archive_refuses_links_escape_duplicate_and_multiple_roots(self):
+        valid = [('foot/' + name, 'file') for name in ('input.c', 'ime.c', 'meson.build', 'LICENSE')]
+        for extra in ([('../escape', 'file')], [('/escape', 'file')], [('other/file', 'file')],
+                      [('foot/link', 'link')], [('foot/input.c', 'file')]):
+            with self.subTest(extra=extra), tempfile.TemporaryDirectory() as work:
+                with self.assertRaises(ValueError):
+                    source.extract(archive(valid + extra), Path(work))
+        with tempfile.TemporaryDirectory() as work:
+            source.extract(archive(valid), Path(work))
+            self.assertEqual((Path(work) / 'input.c').stat().st_mode & 0o7777, 0o755)
+        with tempfile.TemporaryDirectory() as work, self.assertRaisesRegex(ValueError, 'Incomplete'):
+            source.extract(archive([('foot/input.c', 'file')]), Path(work))
+
+
+class FootComponent(unittest.TestCase):
+    def prepare(self, root):
+        component = root / 'component'
+        component.mkdir()
+        elf = bytearray(64)
+        elf[:6] = b'\x7fELF\x02\x01'
+        elf[18:20] = b'\xb7\x00'
+        data = {'foot': bytes(elf), 'LICENSE': b'MIT', 'source.tar.gz': b'fixture archive',
+                '0001-touch-ime-on-short-grid-tap.patch': b'fixture patch', 'packages.lock': b'fcft 3.3.3',
+                'compiler.txt': b'gcc', 'version.txt': b'foot version: 1.28.0 -pgo +ime +graphemes',
+                'touch-ime-tests.json': json.dumps({'kind': 'actual-c-protocol-mocks', 'checks': 460}).encode()}
+        hashes = {name: hashlib.sha256(content).hexdigest() for name, content in data.items()}
+        pin = {'version': '1.28.0', 'sha256': hashes['source.tar.gz'],
+               'patch_sha256': hashes['0001-touch-ime-on-short-grid-tap.patch']}
+        p = root / 'desktop/foot'
+        p.mkdir(parents=True)
+        (p / 'source.json').write_text(json.dumps(pin))
+        for name, content in data.items():
+            (component / name).write_bytes(content)
+        record = {'schema': 1, 'architecture': 'aarch64', 'variant': 'touch-ime-experiment',
+                  'source': pin, 'files': hashes}
+        (component / 'manifest.json').write_text(json.dumps(record))
+        return component, record
+
+    def test_component_supplies_pinned_source_and_audits_root_ownership(self):
+        with tempfile.TemporaryDirectory() as work:
+            root = Path(work)
+            component, record = self.prepare(root)
+            with patch.object(public_root, 'PROJECT', root), patch.object(audit, 'PROJECT', root):
+                files = public_root.foot_files(component)
+                self.assertEqual(files['usr/bin/foot'][1], 0o755)
+                self.assertIn('usr/share/licenses/omarchy-foot-touch-ime/source.tar.gz', files)
+                hashes = {name: hashlib.sha256(data).hexdigest() for name, (data, _) in files.items()}
+                modes = {name: mode for name, (_, mode) in files.items()}
+                owners = {name: 0 for name in files}
+                audit.verify_foot(record, hashes, modes, owners, owners)
+                for metadata, value in ((modes, 0o777), (owners, 1000), (hashes, 'wrong')):
+                    previous = metadata['usr/bin/foot']
+                    metadata['usr/bin/foot'] = value
+                    with self.assertRaises(ValueError):
+                        audit.verify_foot(record, hashes, modes, owners, owners)
+                    metadata['usr/bin/foot'] = previous
+
+    def test_release_default_keeps_packaged_foot_and_explicit_overlay_replaces_it(self):
+        files = {'usr/bin/foot': b'signed-package-foot', 'usr/lib/systemd/systemd': b'systemd',
+                 'etc/group': b'seat:x:1:\nvideo:x:2:\ninput:x:3:\n',
+                 'etc/gshadow': b'seat:!*::\nvideo:!*::\ninput:!*::\n',
+                 'arch-ipad-ui-manifest.json': b'{}',
+                 'home/tablet/.local/share/omarchy-ipad/shell/shell.qml': b'QML'}
+        data = io.BytesIO()
+        with tarfile.open(fileobj=data, mode='w:gz') as tar:
+            parents = {str(parent) for name in files for parent in Path(name).parents if str(parent) != '.'}
+            for name in sorted(parents):
+                item = tarfile.TarInfo(name)
+                item.type, item.mode = tarfile.DIRTYPE, 0o755
+                tar.addfile(item)
+            for name, content in files.items():
+                item = tarfile.TarInfo(name)
+                item.mode, item.size = 0o755, len(content)
+                tar.addfile(item, io.BytesIO(content))
+            item = tarfile.TarInfo('lib')
+            item.type, item.linkname = tarfile.SYMTYPE, 'usr/lib'
+            tar.addfile(item)
+        with tempfile.TemporaryDirectory() as work, ExitStack() as patches:
+            root = Path(work)
+            base, receipt = root / 'base.gz', root / 'base.json'
+            base.write_bytes(data.getvalue())
+            receipt.write_text(json.dumps({'bytes': base.stat().st_size, 'sha256': public_root.sha(base)}))
+            for name in ('privileged_entries', 'cursor_files', 'bluetooth_files', 'labwc_files',
+                         'desktop_additions', 'desktop_replacements', 'system_files'):
+                patches.enter_context(patch.object(public_root, name, return_value={}))
+            foot = patches.enter_context(patch.object(public_root, 'foot_files',
+                return_value={'usr/bin/foot': (b'patched-foot', 0o755)}))
+            for selected in (None, root / 'foot-component'):
+                out = root / ('default' if selected is None else 'experiment')
+                public_root.build(base, receipt, out, 'test', root / 'cursor', foot_tools=selected)
+                raw = subprocess.check_output(['zstd', '-dq', '-c', str(out / 'rootfs.tar.zst')])
+                with tarfile.open(fileobj=io.BytesIO(raw)) as tar:
+                    expected = b'signed-package-foot' if selected is None else b'patched-foot'
+                    self.assertEqual(tar.extractfile('usr/bin/foot').read(), expected)
+                    self.assertEqual(tar.getmember('usr/bin/foot').mode, 0o755)
+                if selected is None:
+                    foot.assert_not_called()
+                else:
+                    foot.assert_called_once_with(selected)
+
+    def test_wrong_target_source_fixture_and_file_content_are_refused(self):
+        mutations = ('architecture', 'source', 'fixture', 'elf', 'version', 'tamper', 'missing', 'link')
+        for mutation in mutations:
+            with self.subTest(mutation=mutation), tempfile.TemporaryDirectory() as work:
+                root = Path(work)
+                component, record = self.prepare(root)
+                rehash = None
+                if mutation == 'architecture':
+                    record['architecture'] = 'x86_64'
+                elif mutation == 'source':
+                    record['source']['version'] = 'wrong'
+                elif mutation == 'fixture':
+                    rehash = 'touch-ime-tests.json'
+                    (component / rehash).write_text('{"kind":"actual-c-protocol-mocks","checks":0}')
+                elif mutation == 'elf':
+                    rehash = 'foot'
+                    (component / rehash).write_bytes(b'not an AArch64 binary')
+                elif mutation == 'version':
+                    rehash = 'version.txt'
+                    (component / rehash).write_text('version: 1.28.0 -ime')
+                elif mutation == 'tamper':
+                    (component / 'foot').write_bytes(b'tampered')
+                elif mutation == 'missing':
+                    del record['files']['LICENSE']
+                elif mutation == 'link':
+                    (component / 'foot').unlink()
+                    (component / 'foot').symlink_to(component / 'LICENSE')
+                if rehash:
+                    record['files'][rehash] = public_root.sha(component / rehash)
+                (component / 'manifest.json').write_text(json.dumps(record))
+                with patch.object(public_root, 'PROJECT', root), self.assertRaises(ValueError):
+                    public_root.foot_files(component)
+
+
+if __name__ == '__main__':
+    unittest.main()
