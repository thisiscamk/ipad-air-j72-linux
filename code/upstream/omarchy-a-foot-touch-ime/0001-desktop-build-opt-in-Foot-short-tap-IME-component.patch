+#!/usr/bin/env bash
+set -euo pipefail
+rank-mirrors
+# Signed Arch packages; this is a disposable build container, never the tablet.
+mapfile -t unneeded < <(pacman -Qq | grep -E '^(linux-aarch64|linux-firmware.*)$')
+(( ${#unneeded[@]} == 0 )) || pacman -Rdd --noconfirm "${unneeded[@]}"
+pacman -Syu --noconfirm --needed gcc meson ninja patch pkgconf python \
+  fcft fontconfig libutf8proc libxkbcommon ncurses pixman tllist wayland wayland-protocols
+pacman -Sc --noconfirm
