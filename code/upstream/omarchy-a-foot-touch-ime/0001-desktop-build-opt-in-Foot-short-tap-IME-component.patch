+#!/usr/bin/env python3
+"""Host-only actual Foot callback/IME function fixture, using protocol mocks."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def function(text, signature):
+    start = text.index(signature)
+    brace = text.index('{', start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+PREFIX = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define unlikely(x) (x)
+#define LOG_INFO(...) ((void)0)
+#define LOG_DBG(...) ((void)0)
+#define BUG(...) assert(0)
+#define BTN_LEFT 272
+#define WL_POINTER_BUTTON_STATE_PRESSED 1
+#define WL_POINTER_BUTTON_STATE_RELEASED 0
+#define ZWP_TEXT_INPUT_V3_CONTENT_HINT_NONE 0
+#define ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_TERMINAL 13
+struct wl_touch { int unused; };
+enum term_surface { TERM_SURF_NONE, TERM_SURF_GRID, TERM_SURF_TITLE };
+enum touch_state { TOUCH_STATE_INHIBITED, TOUCH_STATE_IDLE, TOUCH_STATE_HELD,
+                   TOUCH_STATE_DRAGGING, TOUCH_STATE_SCROLLING };
+struct terminal { enum term_surface active_surface; bool ime_enabled; int scale; };
+struct wl_window { struct terminal *term; };
+struct wayl { void *text_input_manager; };
+struct rect { int x, y, width, height; };
+struct seat {
+ struct { enum touch_state state; int32_t id; void *surface;
+          enum term_surface surface_kind; uint32_t serial; } touch;
+ struct terminal *ime_focus, *mouse_focus;
+ struct wayl *wayl; void *wl_text_input;
+ struct { struct { struct rect pending, sent; } cursor_rect; uint32_t serial; } ime;
+};
+static char journal[1024]; static int pos, resets, clicks;
+static void event(char c) { assert(pos < (int)sizeof(journal)-1); journal[pos++]=c; journal[pos]=0; }
+static void ime_reset_pending(struct seat *s) { (void)s; resets++; }
+static void ime_reset_preedit(struct seat *s) { (void)s; resets++; }
+static void zwp_text_input_v3_disable(void *p) { (void)p; event('D'); }
+static void zwp_text_input_v3_enable(void *p) { (void)p; event('E'); }
+static void zwp_text_input_v3_commit(void *p) { (void)p; event('C'); }
+static void zwp_text_input_v3_set_content_type(void *p, int a, int b) {
+ (void)p; assert(a==0 && b==13); event('T');
+}
+static void zwp_text_input_v3_set_cursor_rectangle(void *p, int x, int y, int w, int h) {
+ (void)p; assert(x==5 && y==10 && w==15 && h==20); event('R');
+}
+static struct wl_window *wl_surface_get_user_data(void *p) { return p; }
+static void wl_pointer_button(struct seat *s, void *p, uint32_t serial,
+                             uint32_t time, int button, int state) {
+ (void)p; assert(time==900 && button==BTN_LEFT);
+ assert(s->mouse_focus && s->mouse_focus->active_surface==s->touch.surface_kind);
+ assert(serial==(state ? 123U : 456U)); clicks++; event(state ? 'P' : 'U');
+}
+'''
+SUFFIX = r'''
+int main(void) {
+ int checks=0;
+ for (int state=0;state<=4;state++)
+ for (int surface=0;surface<=2;surface++)
+ for (int focus=0;focus<3;focus++)
+ for (int manager=0;manager<2;manager++)
+ for (int enabled=0;enabled<2;enabled++)
+ for (int wrong_id=0;wrong_id<2;wrong_id++) {
+  struct terminal term={TERM_SURF_TITLE,enabled,2}, other={TERM_SURF_NONE,true,2};
+  struct wl_window win={&term}; struct wayl wayl={manager ? &win : NULL};
+  struct seat seat={.touch={state,42,&win,surface,123},
+   .ime_focus=focus==0 ? &term : focus==1 ? &other : NULL,
+   .mouse_focus=&other,.wayl=&wayl,
+   .ime={.cursor_rect={.pending={10,20,30,40}},.serial=77}};
+  pos=resets=clicks=0; journal[0]=0;
+  wl_touch_up(&seat,NULL,456,900,wrong_id ? 43 : 42);
+  const bool accepted=state>TOUCH_STATE_IDLE && !wrong_id;
+  const bool request=accepted && state==TOUCH_STATE_HELD && surface==TERM_SURF_GRID && focus==0 && manager;
+  char expected[32]="";
+  if(request) strcat(expected,enabled ? "DCETRC" : "DC");
+  if(accepted && state==TOUCH_STATE_HELD) strcat(expected,"P");
+  if(accepted && (state==TOUCH_STATE_HELD || state==TOUCH_STATE_DRAGGING)) strcat(expected,"U");
+  assert(strcmp(journal,expected)==0);
+  assert(seat.ime.serial==77U+(request ? (enabled ? 2U:1U):0U));
+  assert(resets==(request ? (enabled ? 4:2):0));
+  assert(seat.mouse_focus==&other && term.active_surface==TERM_SURF_TITLE);
+  assert(seat.touch.state==(accepted ? TOUCH_STATE_IDLE:state));
+  if(request && enabled) assert(memcmp(&seat.ime.cursor_rect.pending,&seat.ime.cursor_rect.sent,sizeof(struct rect))==0);
+  checks++;
+ }
+ // Same focused window, manually hidden between taps: every short tap commits
+ // a new disable then enable. No dependency on focus leave/re-enter.
+ struct terminal term={TERM_SURF_TITLE,true,2}; struct wl_window win={&term};
+ struct wayl wayl={&win}; struct seat s={.touch={TOUCH_STATE_HELD,42,&win,TERM_SURF_GRID,123},
+  .ime_focus=&term,.wayl=&wayl,.ime={.cursor_rect={.pending={10,20,30,40}}}};
+ for(int i=0;i<100;i++) {
+  pos=resets=clicks=0; journal[0]=0; s.touch.state=TOUCH_STATE_HELD;
+  wl_touch_up(&s,NULL,456,900,42);
+  assert(strcmp(journal,"DCETRCPU")==0 && s.ime.serial==(uint32_t)(i+1)*2);
+  assert(s.touch.state==TOUCH_STATE_IDLE && s.mouse_focus==NULL);
+  checks++;
+ }
+ printf("%d\n",checks);
+ return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True, help='pinned, patched Foot source directory')
+    args = parser.parse_args()
+    functions = {
+        'touch_up': function((args.source / 'input.c').read_text(), 'static void\nwl_touch_up('),
+        'ime_enable': function((args.source / 'ime.c').read_text(), 'void\nime_enable('),
+        'ime_disable': function((args.source / 'ime.c').read_text(), 'void\nime_disable('),
+    }
+    with tempfile.TemporaryDirectory(prefix='foot-ime-fixture-') as work:
+        source, binary = Path(work) / 'test.c', Path(work) / 'test'
+        source.write_text(PREFIX + functions['ime_enable'] + '\n' + functions['ime_disable'] +
+                          '\n' + functions['touch_up'] + SUFFIX)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-unused-parameter', '-Wno-sign-compare', '-Wno-implicit-fallthrough',
+                        '-fsanitize=undefined,bounds', '-fno-sanitize-recover=all',
+                        str(source), '-o', str(binary)], check=True)
+        checks = int(subprocess.check_output([str(binary)], text=True))
+    print(json.dumps({'schema': 1, 'checks': checks, 'kind': 'actual-c-protocol-mocks',
+                      'functions': {name: hashlib.sha256(text.encode()).hexdigest()
+                                    for name, text in functions.items()}}, sort_keys=True))
+
+
+if __name__ == '__main__':
+    main()
