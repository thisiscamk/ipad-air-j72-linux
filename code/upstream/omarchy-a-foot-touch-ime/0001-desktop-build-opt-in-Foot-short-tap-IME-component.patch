@@ -0,0 +1,36 @@
+"""Safe extraction for the pinned experimental Foot component."""
+import io
+from pathlib import PurePosixPath
+import tarfile
+
+
+def extract(data, directory):
+    """Require one source root and regular files/directories; never extract links."""
+    seen, root = set(), None
+    with tarfile.open(fileobj=io.BytesIO(data)) as archive:
+        for entry in archive:
+            name = PurePosixPath(entry.name)
+            if name.is_absolute() or '..' in name.parts or not name.parts:
+                raise ValueError('Unsafe Foot source member')
+            if root is None:
+                root = name.parts[0]
+            if name.parts[0] != root or not (entry.isdir() or entry.isfile()):
+                raise ValueError('Unexpected Foot source member')
+            relative = PurePosixPath(*name.parts[1:])
+            if str(relative) == '.':
+                if not entry.isdir():
+                    raise ValueError('Foot source root is not a directory')
+                continue
+            if str(relative) in seen:
+                raise ValueError('Duplicate Foot source member')
+            seen.add(str(relative))
+            target = directory.joinpath(*relative.parts)
+            if entry.isdir():
+                target.mkdir(parents=True, exist_ok=True)
+                target.chmod(0o755)
+            else:
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_bytes(archive.extractfile(entry).read())
+                target.chmod(0o755 if entry.mode & 0o111 else 0o644)
+    if not {'input.c', 'ime.c', 'meson.build', 'LICENSE'} <= seen:
+        raise ValueError('Incomplete Foot source archive')
