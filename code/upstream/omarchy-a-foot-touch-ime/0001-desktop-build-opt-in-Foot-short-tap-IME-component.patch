+#!/usr/bin/env python3
+"""Build opt-in Foot 1.28.0 with short grid taps requesting a fresh input method."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import urllib.request
+
+from foot_source import extract
+from snapshot_buildenv import buildenv
+
+HERE = Path(__file__).resolve().parent
+IMAGE = 'localhost/omarchy-a-foot-builder:arm64'
+PATCH = '0001-touch-ime-on-short-grid-tap.patch'
+OPTIONS = ['--buildtype=release', '--wrap-mode=nofallback', '--prefix=/usr',
+           '-Ddocs=disabled', '-Dthemes=false', '-Dterminfo=disabled',
+           '-Dime=true', '-Dutmp-backend=none', '-Dgrapheme-clustering=enabled']
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', required=True, type=Path)
+    parser.add_argument('--archive', type=Path, help='cached pinned upstream archive')
+    args = parser.parse_args()
+    if args.output.exists() or args.output.is_symlink():
+        parser.error('Choose a new Foot output directory')
+    pin = json.loads((HERE / 'foot/source.json').read_text())
+    patch = HERE / 'foot' / PATCH
+    if sha(patch) != pin['patch_sha256']:
+        parser.error('Foot patch differs from pin')
+    data = args.archive.read_bytes() if args.archive else urllib.request.urlopen(pin['url'], timeout=30).read()
+    if hashlib.sha256(data).hexdigest() != pin['sha256']:
+        parser.error('Foot source differs from pin')
+    buildenv.build(IMAGE, HERE / 'foot/Containerfile', HERE / 'foot')
+    image_id = buildenv.identity(IMAGE)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(dir=args.output.parent, prefix='.foot-') as directory:
+        work = Path(directory).resolve()
+        source, output = work / 'source', work / 'output'
+        source.mkdir(); output.mkdir()
+        extract(data, source)
+        subprocess.run(['patch', '--batch', '--fuzz=0', '-p1', '-i', str(patch.resolve())],
+                       cwd=source, check=True)
+        # This fixture compiles the actual patched callback and actual IME enable/disable
+        # functions with protocol mocks. It needs neither a compositor nor a device.
+        shutil.copyfile(HERE / 'foot/test-touch-ime.py', source / 'test-touch-ime.py')
+        recipe = '''
+set -eu
+umask 022
+test "$(uname -m)" = aarch64
+python "$ORCHARD_SOURCE/test-touch-ime.py" --source "$ORCHARD_SOURCE" > "$ORCHARD_OUTPUT/touch-ime-tests.json"
+meson setup "$ORCHARD_WORK/build" "$ORCHARD_SOURCE" ''' + ' '.join(OPTIONS) + '''
+meson compile -C "$ORCHARD_WORK/build" -j1
+meson test -C "$ORCHARD_WORK/build" --no-rebuild --print-errorlogs
+cp "$ORCHARD_WORK/build/foot" "$ORCHARD_OUTPUT/foot"
+chmod 755 "$ORCHARD_OUTPUT/foot"
+pacman -Q > "$ORCHARD_OUTPUT/packages.lock"
+cc --version > "$ORCHARD_OUTPUT/compiler.txt"
+"$ORCHARD_OUTPUT/foot" --version > "$ORCHARD_OUTPUT/version.txt"
+'''
+        buildenv.run(IMAGE, ['sh', '-c', recipe],
+                     [(source, '/source', True), (output, '/output', False)], root=True)
+        shutil.copyfile(source / 'LICENSE', output / 'LICENSE')
+        shutil.copyfile(patch, output / PATCH)
+        (output / 'source.tar.gz').write_bytes(data)
+        record = {'schema': 1, 'architecture': 'aarch64', 'variant': 'touch-ime-experiment',
+                  'source': pin, 'compiler_image': image_id, 'build_options': OPTIONS,
+                  'files': {p.name: sha(p) for p in sorted(output.iterdir())}}
+        (output / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
+        shutil.move(output, args.output)
+    print('Experimental Foot component built:', args.output)
+
+
+if __name__ == '__main__':
+    main()
