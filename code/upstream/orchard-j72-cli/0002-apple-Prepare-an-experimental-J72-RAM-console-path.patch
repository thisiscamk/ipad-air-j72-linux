@@ -0,0 +1,18 @@
+# USB console
+
+A small RAM payload for checking a new board's kernel and Orchard host link.
+It starts USB serial and key-authenticated SSH through Orchard's normal
+`usb-session` helper. It does not load optional drivers or mount storage.
+Drivers built into the selected kernel can still probe devices described by
+that board's device tree.
+
+```sh
+/path/to/orchard/bin/orchard build examples/usb-console --device BOARD
+/path/to/orchard/bin/orchard run examples/usb-console --no-build
+/path/to/orchard/bin/orchard shell
+/path/to/orchard/bin/orchard exec -- uname -a
+```
+
+Use the checkout's launcher explicitly. Build success does not establish
+that a new board boots, and this payload supplies no desktop or charging
+policy. Restart into the device's normal OS when the test is finished.
diff --git a/examples/usb-console/init b/examples/usb-console/init
new file mode 100755
index 0000000..8b024a0
--- /dev/null
+++ b/examples/usb-console/init
@@ -0,0 +1,23 @@
+#!/bin/busybox sh
+# RAM-only console: no coldplug, storage mounts or optional driver loading.
+set -eu
+export PATH=/usr/sbin:/usr/bin:/sbin:/bin
+/bin/busybox --install -s /bin
+mount -t proc -o nosuid,nodev,noexec proc /proc
+mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
+mount -t devtmpfs -o nosuid devtmpfs /dev
+mount -t tmpfs -o nosuid,nodev tmpfs /run
+mkdir -p /dev/pts /var/run /tmp
+mount -t devpts devpts /dev/pts
+exec </dev/console >/dev/console 2>&1
+echo /bin/false > /proc/sys/kernel/modprobe
+echo /bin/false > /proc/sys/kernel/hotplug
+
+# Standard Orchard transport: ACM serial, NCM networking and Dropbear.
+sh /usr/libexec/orchard/usb-session || echo 'USB session failed; see above'
+echo "$(cat /etc/hostname): RAM console; no optional drivers loaded or storage mounted."
+echo 'Physical USB root shell is unauthenticated; connect only to a trusted host.'
+while :; do
+    setsid -c sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1 || true
+    sleep 1
+done
